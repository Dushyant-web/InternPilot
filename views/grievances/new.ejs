<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto space-y-5">
    <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/grievance" class="hover:text-indigo-600">Grievance Redressal</a>
        <i class="ph-bold ph-caret-right text-[10px]" aria-hidden="true"></i>
        <a href="/grievances/mine" class="hover:text-indigo-600">My grievances</a>
        <i class="ph-bold ph-caret-right text-[10px]" aria-hidden="true"></i>
        <span class="text-slate-700 font-semibold">Raise a grievance</span>
    </nav>

    <div class="border-b border-slate-200 pb-4">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Raise a grievance</h1>
        <p class="text-xs text-slate-500 mt-1">Tell us what went wrong. You get a ticket number straight away, and the Internal Helpdesk replies within 48 hours.</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-5 items-start">
        <form action="/grievances/new" method="POST" class="lg:col-span-2 bg-white border border-slate-200 rounded-xl shadow-sm p-5 space-y-4">
            <% if (errors.length) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-lg px-4 py-3 text-xs" role="alert">
                    <p class="font-semibold mb-1">Please fix these first:</p>
                    <ul class="list-disc pl-4 space-y-0.5">
                        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
                    </ul>
                </div>
            <% } %>

            <div>
                <label for="grievanceCategory" class="block text-xs font-semibold text-slate-700 mb-1">What is it about?</label>
                <select id="grievanceCategory" name="category" required
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    <option value="">Choose a category</option>
                    <% Object.entries(categories).forEach(([key, label]) => { %>
                        <option value="<%= key %>" <%= values.category === key ? 'selected' : '' %>><%= label %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label for="grievanceLink" class="block text-xs font-semibold text-slate-700 mb-1">Related to <span class="font-normal text-slate-400">(optional)</span></label>
                <select id="grievanceLink" name="link"
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    <option value="">Not about a specific application or listing</option>
                    <% linkOptions.forEach(option => { %>
                        <option value="<%= option.value %>" <%= values.link === option.value ? 'selected' : '' %>><%= option.label %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label for="grievanceSubject" class="block text-xs font-semibold text-slate-700 mb-1">Subject</label>
                <input id="grievanceSubject" name="subject" type="text" required minlength="5" maxlength="<%= limits.subject %>"
                    value="<%= values.subject || '' %>" placeholder="e.g. Stipend for August not received"
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>

            <div>
                <label for="grievanceDescription" class="block text-xs font-semibold text-slate-700 mb-1">What happened?</label>
                <textarea id="grievanceDescription" name="description" rows="7" required minlength="20" maxlength="<%= limits.description %>"
                    placeholder="Include dates, amounts and names where you can."
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600"><%= values.description || '' %></textarea>
                <p class="text-[11px] text-slate-400 mt-1">Never share passwords, OTPs or bank PINs. The grievance team will never ask for them.</p>
            </div>

            <div class="flex items-center justify-end gap-2 pt-1">
                <a href="/grievances/mine" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900">Cancel</a>
                <button type="submit"
                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg transition-colors">
                    <i class="ph-bold ph-paper-plane-tilt" aria-hidden="true"></i> Raise grievance
                </button>
            </div>
        </form>

        <aside class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 space-y-3" aria-labelledby="whatNext">
            <h2 id="whatNext" class="text-sm font-bold text-slate-900">What happens next</h2>
            <ol class="space-y-3">
                <% Object.entries(tiers).forEach(([n, tier]) => { %>
                    <li class="flex gap-3">
                        <span class="shrink-0 w-6 h-6 rounded-full bg-slate-100 text-slate-700 text-[11px] font-bold flex items-center justify-center"><%= n %></span>
                        <span>
                            <span class="block text-xs font-semibold text-slate-800"><%= tier.desk %></span>
                            <span class="block text-[11px] text-slate-500">Responds within <%= tier.sla %></span>
                        </span>
                    </li>
                <% }) %>
            </ol>
            <p class="text-[11px] text-slate-500 leading-relaxed border-t border-slate-100 pt-3">
                If a tier misses its deadline, the grievance moves up automatically. You'll get a notification each time something changes.
            </p>
        </aside>
    </div>
</div>
