<% layout('layouts/boilerplate') %>
<%
    const icons = {
        created: 'ph-flag',
        reply: 'ph-chat-circle-text',
        response: 'ph-headset',
        status: 'ph-arrows-clockwise',
        escalated: 'ph-trend-up',
        reopened: 'ph-arrow-counter-clockwise'
    };
    const who = u => u.byRole === 'admin' ? 'Grievance team' : (u.byRole === 'system' ? 'Automatic' : (isAdmin ? 'Raiser' : 'You'));
    const raiser = g.raisedBy && g.raisedBy.name ? g.raisedBy : null;
%>

<div class="max-w-4xl mx-auto space-y-5">
    <a href="<%= isAdmin ? '/admin/grievances' : '/grievances/mine' %>" class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 hover:underline">
        <i class="ph-bold ph-arrow-left" aria-hidden="true"></i> <%= isAdmin ? 'Grievance desk' : 'My grievances' %>
    </a>

    <section class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 space-y-3" aria-labelledby="grievanceSubject">
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-semibold text-slate-500"><%= g.ticket %></span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border <%= g.statusBadge %>" data-status="<%= g.status %>"><%= g.statusLabel %></span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border bg-slate-50 text-slate-600 border-slate-200" data-tier="<%= g.tier %>"><%= g.tierLabel %> · <%= g.tierDesk %></span>
            <% if (g.overdue) { %>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border bg-rose-50 text-rose-700 border-rose-200" data-overdue>Overdue</span>
            <% } %>
        </div>
        <h1 id="grievanceSubject" class="text-xl font-bold text-slate-900 break-words"><%= g.subject %></h1>
        <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-xs">
            <div><dt class="text-slate-400">Category</dt><dd class="font-semibold text-slate-700"><%= g.categoryLabel %></dd></div>
            <div><dt class="text-slate-400">Raised on</dt><dd class="font-semibold text-slate-700"><%= g.createdLabel %></dd></div>
            <% if (isAdmin && raiser) { %>
                <div><dt class="text-slate-400">Raised by</dt><dd class="font-semibold text-slate-700"><%= raiser.name %> <span class="font-normal text-slate-500">(<%= raiser.email %>, <%= g.raiserRole %>)</span></dd></div>
            <% } %>
            <% if (g.internship && g.internship.title) { %>
                <div><dt class="text-slate-400">Related to</dt><dd class="font-semibold text-slate-700"><%= g.internship.title %><%= g.internship.companyName ? ' (' + g.internship.companyName + ')' : '' %></dd></div>
            <% } %>
            <% if (g.active) { %>
                <div><dt class="text-slate-400">Response due</dt><dd class="font-semibold <%= g.overdue ? 'text-rose-600' : 'text-slate-700' %>"><%= g.dueLabel %> <span class="font-normal">(<%= g.timeLeft %>)</span></dd></div>
            <% } %>
        </dl>
        <div class="border-t border-slate-100 pt-3">
            <p class="text-sm text-slate-700 whitespace-pre-wrap break-words" data-description><%= g.description %></p>
        </div>
    </section>

    <section class="bg-white border border-slate-200 rounded-xl shadow-sm p-5" aria-labelledby="timelineTitle">
        <h2 id="timelineTitle" class="text-sm font-bold text-slate-900 mb-3">Timeline</h2>
        <ol class="space-y-4">
            <% g.updates.forEach(u => { %>
                <li class="flex gap-3" data-update="<%= u.kind %>">
                    <span class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center <%= u.byRole === 'admin' ? 'bg-indigo-50 text-indigo-600' : (u.byRole === 'system' ? 'bg-amber-50 text-amber-600' : 'bg-slate-100 text-slate-600') %>">
                        <i class="ph-bold <%= icons[u.kind] || 'ph-dot' %> text-sm" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-semibold text-slate-800"><%= u.title %> <span class="font-normal text-slate-400">· <%= who(u) %> · <%= u.atLabel %></span></p>
                        <% if (u.message) { %>
                            <p class="text-sm text-slate-700 mt-1 whitespace-pre-wrap break-words"><%= u.message %></p>
                        <% } %>
                    </div>
                </li>
            <% }) %>
        </ol>
    </section>

    <% if (g.active && g.tier === 3) { %>
        <p class="text-xs text-slate-600 bg-slate-50 border border-slate-200 rounded-lg px-4 py-3">
            This grievance is at the highest level. You can also file it on the
            <a href="https://pgportal.gov.in" target="_blank" rel="noopener noreferrer" class="text-indigo-600 font-semibold hover:underline">CPGRAMS portal</a>
            and quote ticket <span class="font-mono"><%= g.ticket %></span>.
        </p>
    <% } %>

    <% if (!isAdmin) { %>
        <% if (g.active) { %>
            <form action="/grievances/<%= g.ticket %>/reply" method="POST" class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 space-y-3" id="replyForm">
                <label for="replyMessage" class="block text-sm font-bold text-slate-900">Add a reply</label>
                <textarea id="replyMessage" name="message" rows="3" required maxlength="<%= limits.message %>"
                    placeholder="Add details or answer a question from the grievance team."
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
                <div class="flex justify-end">
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">Send reply</button>
                </div>
            </form>
        <% } else if (g.canReopen) { %>
            <form action="/grievances/<%= g.ticket %>/reopen" method="POST" class="bg-white border border-amber-200 rounded-xl shadow-sm p-5 space-y-3" id="reopenForm">
                <label for="reopenMessage" class="block text-sm font-bold text-slate-900">Not fixed? Reopen it</label>
                <p class="text-xs text-slate-500">You can reopen a resolved grievance once, within <%= limits.reopenDays %> days.</p>
                <textarea id="reopenMessage" name="message" rows="3" required maxlength="<%= limits.message %>"
                    placeholder="Tell us why the resolution didn't fix the problem."
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
                <div class="flex justify-end">
                    <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg">Reopen grievance</button>
                </div>
            </form>
        <% } else { %>
            <p class="text-xs text-slate-500 text-center">This grievance is <%= g.statusLabel.toLowerCase() %>. Raise a new one if you need more help.</p>
        <% } %>
    <% } else if (g.status !== 'closed') { %>
        <div class="grid md:grid-cols-3 gap-4">
            <form action="/admin/grievances/<%= g.ticket %>/respond" method="POST" class="md:col-span-2 bg-white border border-slate-200 rounded-xl shadow-sm p-5 space-y-3" id="respondForm">
                <label for="respondMessage" class="block text-sm font-bold text-slate-900">Respond</label>
                <textarea id="respondMessage" name="message" rows="4" maxlength="<%= limits.message %>"
                    placeholder="Reply to the raiser. A note is required when you resolve."
                    class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <label class="text-xs text-slate-600 flex items-center gap-2">Status
                        <select name="status" class="px-2 py-1.5 text-xs border border-slate-200 rounded-lg bg-white">
                            <% Object.entries(statuses).forEach(([key, s]) => { %>
                                <option value="<%= key %>" <%= g.status === key ? 'selected' : '' %>><%= s.label %></option>
                            <% }) %>
                        </select>
                    </label>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">Save and notify</button>
                </div>
            </form>
            <% if (g.active && g.tier < 3) { %>
                <form action="/admin/grievances/<%= g.ticket %>/escalate" method="POST" class="bg-white border border-slate-200 rounded-xl shadow-sm p-5 space-y-2" id="escalateForm">
                    <p class="text-sm font-bold text-slate-900">Escalate</p>
                    <p class="text-xs text-slate-500">Move it to Tier <%= g.tier + 1 %> now, with a fresh deadline.</p>
                    <button type="submit" class="w-full px-4 py-2 bg-white border border-rose-200 text-rose-700 hover:bg-rose-50 text-xs font-semibold rounded-lg">Escalate to Tier <%= g.tier + 1 %></button>
                </form>
            <% } %>
        </div>
    <% } %>
</div>
