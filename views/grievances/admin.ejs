<% layout('layouts/boilerplate') %>
<%
    const chip = (label, count, params, active) => ({ label, count, href: '/admin/grievances' + (params ? '?' + params : ''), active });
    const current = filters.overdue ? 'overdue' : (filters.status || 'active');
    const chips = [
        chip('Active', counts.active, '', current === 'active'),
        chip('Overdue', counts.overdue, 'overdue=1', current === 'overdue'),
        chip('Open', counts.open, 'status=open', current === 'open'),
        chip('In review', counts.in_review, 'status=in_review', current === 'in_review'),
        chip('Resolved', counts.resolved, 'status=resolved', current === 'resolved'),
        chip('Closed', counts.closed, 'status=closed', current === 'closed'),
        chip('All', counts.open + counts.in_review + counts.resolved + counts.closed, 'status=all', current === 'all')
    ];
%>

<div class="max-w-6xl mx-auto space-y-5">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Grievance desk</h1>
            <p class="text-xs text-slate-500 mt-0.5">Overdue tickets move up a tier on their own. Oldest deadline first.</p>
        </div>
        <a href="/grievance" class="text-xs font-semibold text-indigo-600 hover:underline">Redressal policy</a>
    </div>

    <nav class="flex flex-wrap gap-2" aria-label="Quick filters">
        <% chips.forEach(c => { %>
            <a href="<%= c.href %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-semibold transition-colors <%= c.active ? 'bg-slate-900 text-white border-slate-900' : (c.label === 'Overdue' && c.count ? 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50') %>"
                <%= c.active ? 'aria-current=page' : '' %>>
                <%= c.label %> <span class="tabular-nums opacity-80" data-count="<%= c.label %>"><%= c.count %></span>
            </a>
        <% }) %>
    </nav>

    <form method="GET" action="/admin/grievances" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 flex flex-wrap items-end gap-3">
        <label class="text-xs text-slate-600 flex flex-col gap-1">Status
            <select name="status" class="px-2 py-1.5 text-xs border border-slate-200 rounded-lg bg-white">
                <option value="">Active</option>
                <% Object.entries(statuses).forEach(([key, s]) => { %>
                    <option value="<%= key %>" <%= filters.status === key ? 'selected' : '' %>><%= s.label %></option>
                <% }) %>
                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
            </select>
        </label>
        <label class="text-xs text-slate-600 flex flex-col gap-1">Tier
            <select name="tier" class="px-2 py-1.5 text-xs border border-slate-200 rounded-lg bg-white">
                <option value="">Any tier</option>
                <% Object.entries(tiers).forEach(([n, t]) => { %>
                    <option value="<%= n %>" <%= filters.tier === n ? 'selected' : '' %>><%= t.label %> · <%= t.desk %></option>
                <% }) %>
            </select>
        </label>
        <label class="text-xs text-slate-600 flex flex-col gap-1">Category
            <select name="category" class="px-2 py-1.5 text-xs border border-slate-200 rounded-lg bg-white">
                <option value="">Any category</option>
                <% Object.entries(categories).forEach(([key, label]) => { %>
                    <option value="<%= key %>" <%= filters.category === key ? 'selected' : '' %>><%= label %></option>
                <% }) %>
            </select>
        </label>
        <label class="text-xs text-slate-600 flex items-center gap-2 pb-1.5">
            <input type="checkbox" name="overdue" value="1" <%= filters.overdue ? 'checked' : '' %> class="accent-rose-600"> Overdue only
        </label>
        <button type="submit" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">Apply</button>
    </form>

    <% if (!items.length) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-10 text-center shadow-sm">
            <i class="ph-bold ph-check-circle text-4xl text-emerald-300 mb-2" aria-hidden="true"></i>
            <p class="text-sm font-semibold text-slate-700">No grievances match these filters.</p>
        </div>
    <% } else { %>
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px]">
                    <tr>
                        <th class="px-4 py-2.5 font-semibold">Ticket</th>
                        <th class="px-4 py-2.5 font-semibold">Subject</th>
                        <th class="px-4 py-2.5 font-semibold">Category</th>
                        <th class="px-4 py-2.5 font-semibold">Tier</th>
                        <th class="px-4 py-2.5 font-semibold">Status</th>
                        <th class="px-4 py-2.5 font-semibold">Due</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% items.forEach(g => { %>
                        <tr class="<%= g.overdue ? 'bg-rose-50/40' : '' %>" data-ticket="<%= g.ticket %>">
                            <td class="px-4 py-3 font-mono font-semibold whitespace-nowrap">
                                <a href="/grievances/<%= g.ticket %>" class="text-indigo-600 hover:underline"><%= g.ticket %></a>
                            </td>
                            <td class="px-4 py-3 max-w-xs">
                                <span class="block font-semibold text-slate-800 truncate"><%= g.subject %></span>
                                <span class="block text-[11px] text-slate-500 truncate"><%= g.raisedBy && g.raisedBy.name ? g.raisedBy.name : 'Unknown' %> · <%= g.raiserRole %></span>
                            </td>
                            <td class="px-4 py-3 text-slate-600"><%= g.categoryLabel %></td>
                            <td class="px-4 py-3 whitespace-nowrap text-slate-600"><%= g.tierLabel %></td>
                            <td class="px-4 py-3"><span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border <%= g.statusBadge %>"><%= g.statusLabel %></span></td>
                            <td class="px-4 py-3 whitespace-nowrap <%= g.overdue ? 'text-rose-600 font-semibold' : 'text-slate-600' %>"><%= g.active ? g.timeLeft : '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
