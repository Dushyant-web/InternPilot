<% layout('layouts/boilerplate') %>
<%
    const statusClass = {
        Submitted: 'bg-slate-50 text-slate-600 border-slate-200',
        'Under Review': 'bg-sky-50 text-sky-700 border-sky-200',
        Shortlisted: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        Interview: 'bg-violet-50 text-violet-700 border-violet-200',
        Hired: 'bg-emerald-50 text-emerald-700 border-emerald-200',
        Rejected: 'bg-rose-50 text-rose-700 border-rose-200',
        Withdrawn: 'bg-slate-100 text-slate-500 border-slate-200'
    };
%>

<div class="max-w-7xl mx-auto lg:grid lg:grid-cols-[210px_minmax(0,1fr)] gap-6">
    <%- include('_nav') %>

    <div class="min-w-0 space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Applications</h1>
                <p class="text-xs text-slate-500 mt-0.5"><%= total.toLocaleString('en-IN') %> applications match. Read-only: companies manage their own applicants.</p>
            </div>
            <a href="/admin/applications.csv?<%= csvQuery %>" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg">
                <i class="ph-bold ph-download-simple" aria-hidden="true"></i> Download CSV
            </a>
        </div>

        <form method="GET" action="/admin/applications" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 flex flex-wrap items-end gap-3">
            <label class="text-xs text-slate-600 flex flex-col gap-1 grow min-w-[12rem]">Search
                <input type="search" name="q" value="<%= filters.q %>" placeholder="Candidate, email, internship or company"
                    class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </label>
            <label class="text-xs text-slate-600 flex flex-col gap-1">Status
                <select name="status" class="px-2 py-2 text-xs border border-slate-200 rounded-lg bg-white">
                    <option value="">Any status</option>
                    <% statuses.forEach(s => { %>
                        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                </select>
            </label>
            <label class="text-xs text-slate-600 flex flex-col gap-1">From
                <input type="date" name="from" value="<%= filters.from %>" class="px-2 py-1.5 text-xs border border-slate-200 rounded-lg">
            </label>
            <label class="text-xs text-slate-600 flex flex-col gap-1">To
                <input type="date" name="to" value="<%= filters.to %>" class="px-2 py-1.5 text-xs border border-slate-200 rounded-lg">
            </label>
            <button type="submit" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">Apply</button>
        </form>

        <p class="flex flex-wrap gap-2 text-[11px]">
            <% statuses.forEach(s => { %>
                <span class="px-2 py-0.5 rounded-full border font-semibold <%= statusClass[s] %>" data-status-count="<%= s %>"><%= s %> <span class="tabular-nums"><%= counts[s] || 0 %></span></span>
            <% }) %>
        </p>

        <% if (!items.length) { %>
            <div class="bg-white border border-slate-200 rounded-xl p-10 text-center shadow-sm">
                <p class="text-sm font-semibold text-slate-700">No applications match these filters.</p>
            </div>
        <% } else { %>
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-500">
                        <tr><th class="px-4 py-2.5">Applied</th><th class="px-4 py-2.5">Candidate</th><th class="px-4 py-2.5">Internship</th><th class="px-4 py-2.5">Status</th><th class="px-4 py-2.5">Match</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% items.forEach(a => { %>
                            <tr data-application="<%= a._id %>">
                                <td class="px-4 py-3 text-slate-500 whitespace-nowrap"><%= a.appliedLabel %></td>
                                <td class="px-4 py-3">
                                    <% if (a.candidate) { %>
                                        <a href="/admin/users/<%= a.candidate._id %>" class="font-semibold text-indigo-700 hover:underline"><%= a.candidate.name %></a>
                                        <span class="block text-[11px] text-slate-500"><%= a.candidate.email %><%= a.candidate.location && a.candidate.location.state ? ' · ' + a.candidate.location.state : '' %></span>
                                    <% } else { %>
                                        <span class="text-slate-400">Deleted account</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="font-semibold text-slate-800"><%= (a.internship && a.internship.title) || 'Removed listing' %></span>
                                    <span class="block text-[11px] text-slate-500"><%= a.internship && a.internship.companyName %></span>
                                </td>
                                <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full border text-[10px] font-semibold <%= statusClass[a.status] || statusClass.Submitted %>"><%= a.status %></span></td>
                                <td class="px-4 py-3 tabular-nums text-slate-600"><%= a.matchScore === undefined || a.matchScore === null ? '-' : a.matchScore + '%' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <%- include('_pager', { pagerBase: '/admin/applications', pagerParams: { status: filters.status, q: filters.q, from: filters.from, to: filters.to } }) %>
    </div>
</div>
