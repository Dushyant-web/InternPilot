<% layout('layouts/boilerplate') %>

<div class="max-w-7xl mx-auto lg:grid lg:grid-cols-[210px_minmax(0,1fr)] gap-6">
    <%- include('_nav') %>

    <div class="min-w-0 space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Users</h1>
                <p class="text-xs text-slate-500 mt-0.5"><%= total.toLocaleString('en-IN') %> matching accounts. Open one to see their activity or suspend sign-in.</p>
            </div>
        </div>

        <form method="GET" action="/admin/users" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 flex flex-wrap items-end gap-3">
            <label class="text-xs text-slate-600 flex flex-col gap-1 grow min-w-[12rem]">Search
                <input type="search" name="q" value="<%= filters.q %>" placeholder="Name, email or company"
                    class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </label>
            <label class="text-xs text-slate-600 flex flex-col gap-1">Role
                <select name="role" class="px-2 py-2 text-xs border border-slate-200 rounded-lg bg-white">
                    <option value="">Any role</option>
                    <% Object.entries(roles).forEach(([key, label]) => { %>
                        <option value="<%= key %>" <%= filters.role === key ? 'selected' : '' %>><%= label %></option>
                    <% }) %>
                </select>
            </label>
            <label class="text-xs text-slate-600 flex flex-col gap-1">Status
                <select name="status" class="px-2 py-2 text-xs border border-slate-200 rounded-lg bg-white">
                    <option value="">Any status</option>
                    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                </select>
            </label>
            <button type="submit" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">Apply</button>
        </form>

        <% if (!items.length) { %>
            <div class="bg-white border border-slate-200 rounded-xl p-10 text-center shadow-sm">
                <p class="text-sm font-semibold text-slate-700">No accounts match these filters.</p>
            </div>
        <% } else { %>
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-500">
                        <tr><th class="px-4 py-2.5">Account</th><th class="px-4 py-2.5">Role</th><th class="px-4 py-2.5">Company / state</th><th class="px-4 py-2.5">Joined</th><th class="px-4 py-2.5">Status</th><th class="px-4 py-2.5"><span class="sr-only">Actions</span></th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% items.forEach(u => { %>
                            <tr data-user="<%= u._id %>">
                                <td class="px-4 py-3">
                                    <a href="/admin/users/<%= u._id %>" class="block font-semibold text-indigo-700 hover:underline"><%= u.name || 'Unnamed' %></a>
                                    <span class="block text-[11px] text-slate-500"><%= u.email %></span>
                                </td>
                                <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full border bg-slate-50 border-slate-200 text-slate-600 font-semibold text-[10px]"><%= u.roleLabel %></span></td>
                                <td class="px-4 py-3 text-slate-600">
                                    <% if (u.companyDetails && u.companyDetails.companyName) { %>
                                        <%= u.companyDetails.companyName %>
                                        <% if (u.role === 'company') { %><span class="ml-1 text-[10px] font-semibold <%= u.companyDetails.isVerified ? 'text-emerald-600' : 'text-amber-600' %>"><%= u.companyDetails.isVerified ? 'verified' : 'unverified' %></span><% } %>
                                    <% } else { %>
                                        <%= (u.location && u.location.state) || '-' %>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-slate-500 whitespace-nowrap"><%= u.joinedLabel %></td>
                                <td class="px-4 py-3">
                                    <% if (u.suspended) { %>
                                        <span class="px-2 py-0.5 rounded-full border bg-rose-50 border-rose-200 text-rose-700 font-bold text-[10px]" data-suspended>Suspended</span>
                                    <% } else { %>
                                        <span class="text-[11px] text-slate-500">Active</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-right whitespace-nowrap">
                                    <a href="/admin/users/<%= u._id %>" class="text-xs font-semibold text-indigo-600 hover:underline">Manage</a>
                                    <% if (u.deletable) { %>
                                        <a href="/admin/users/<%= u._id %>#dangerZone" class="ml-3 text-xs font-semibold text-rose-600 hover:underline" data-delete-link>Delete</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <%- include('_pager', { pagerBase: '/admin/users', pagerParams: { q: filters.q, role: filters.role, status: filters.status } }) %>
    </div>
</div>
