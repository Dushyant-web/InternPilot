<% layout('layouts/boilerplate') %>
<%
    const fmt = n => Number(n || 0).toLocaleString('en-IN');
    const changeBadge = c => {
        if (c === null) return { text: 'new', cls: 'bg-indigo-50 text-indigo-700 border-indigo-100' };
        if (c > 0) return { text: '+' + c + '%', cls: 'bg-emerald-50 text-emerald-700 border-emerald-100' };
        if (c < 0) return { text: c + '%', cls: 'bg-rose-50 text-rose-700 border-rose-100' };
        return { text: '0%', cls: 'bg-slate-50 text-slate-500 border-slate-200' };
    };
    const steps = data.funnel.steps;
    const funnelTop = Math.max(1, steps[0].reached);
    const stateTop = Math.max(1, ...data.states.map(s => s.applications));
    const pmisTotal = data.pmis.eligible + data.pmis.ineligible + data.pmis.incomplete;
    const share = (n, total) => (total ? Math.round((n / total) * 100) : 0);
    const supplyTag = ratio => ratio < 1
        ? { text: 'Short', cls: 'bg-rose-50 text-rose-700' }
        : (ratio < 3 ? { text: 'Tight', cls: 'bg-amber-50 text-amber-700' } : { text: 'Healthy', cls: 'bg-emerald-50 text-emerald-700' });
%>

<div class="max-w-7xl mx-auto lg:grid lg:grid-cols-[210px_minmax(0,1fr)] gap-6">
    <%- include('_nav') %>

    <div class="min-w-0 space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Overview</h1>
                <p class="text-xs text-slate-500 mt-0.5">How the scheme is doing: <%= data.rangeLabel.toLowerCase() %>, compared with the same number of days before.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="inline-flex bg-white border border-slate-200 rounded-lg p-0.5" role="group" aria-label="Date range">
                    <% Object.entries(ranges).forEach(([days, label]) => { %>
                        <a href="/admin/overview?range=<%= days %>" <%= Number(days) === data.range ? 'aria-current=page' : '' %>
                            class="px-3 py-1.5 rounded-md text-xs font-semibold <%= Number(days) === data.range ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-50' %>"><%= days %> days</a>
                    <% }) %>
                </div>
                <a href="/admin/overview.csv?range=<%= data.range %>" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg">
                    <i class="ph-bold ph-download-simple" aria-hidden="true"></i> CSV
                </a>
            </div>
        </div>

        <section class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-3" aria-label="Headline numbers">
            <% data.summary.cards.forEach(card => { const badge = changeBadge(card.change); %>
                <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm" data-kpi="<%= card.key %>">
                    <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide"><%= card.label %></p>
                    <p class="text-2xl font-extrabold text-slate-900 mt-1 tabular-nums"><%= fmt(card.value) %></p>
                    <p class="text-[11px] text-slate-500 mt-1 flex items-center gap-1.5">
                        <span class="px-1.5 py-0.5 rounded border font-semibold <%= badge.cls %>"><%= badge.text %></span>
                        <span>vs <%= fmt(card.previous) %></span>
                    </p>
                </div>
            <% }) %>
        </section>

        <section class="grid sm:grid-cols-3 gap-3" aria-label="Right now">
            <a href="/admin/dashboard" class="bg-white border <%= data.summary.totals.pendingCompanies ? 'border-amber-200' : 'border-slate-200' %> rounded-xl p-4 shadow-sm hover:shadow-md transition-shadow">
                <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Companies waiting for verification</p>
                <p class="text-xl font-bold text-slate-900 mt-1"><%= fmt(data.summary.totals.pendingCompanies) %></p>
            </a>
            <a href="/admin/listings" class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-shadow">
                <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Live listings</p>
                <p class="text-xl font-bold text-slate-900 mt-1"><%= fmt(data.summary.totals.liveListings) %></p>
            </a>
            <a href="/admin/users?role=candidate" class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-shadow">
                <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Candidates in total</p>
                <p class="text-xl font-bold text-slate-900 mt-1"><%= fmt(data.summary.totals.allCandidates) %></p>
            </a>
        </section>

        <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm" aria-labelledby="trendTitle">
            <h2 id="trendTitle" class="text-sm font-bold text-slate-900">Sign-ups and applications per day</h2>
            <div class="relative h-64 mt-3">
                <canvas id="trendChart" role="img" aria-label="Daily sign-ups and applications"></canvas>
            </div>
            <details class="mt-3 text-xs text-slate-600">
                <summary class="cursor-pointer font-semibold text-slate-500">Show as a table</summary>
                <div class="overflow-x-auto mt-2">
                    <table class="w-full text-left">
                        <thead class="text-[10px] uppercase text-slate-400"><tr><th class="py-1 pr-4">Day</th><th class="py-1 pr-4">Sign-ups</th><th class="py-1">Applications</th></tr></thead>
                        <tbody>
                            <% data.series.labels.forEach((day, i) => { %>
                                <tr class="border-t border-slate-100"><td class="py-1 pr-4"><%= day %></td><td class="py-1 pr-4 tabular-nums"><%= data.series.signups[i] %></td><td class="py-1 tabular-nums"><%= data.series.applications[i] %></td></tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </details>
        </section>

        <div class="grid xl:grid-cols-2 gap-5">
            <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm" aria-labelledby="funnelTitle">
                <h2 id="funnelTitle" class="text-sm font-bold text-slate-900">Application funnel</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Applications made in this period and the furthest stage each one reached.</p>
                <% if (!data.funnel.total) { %>
                    <p class="text-xs text-slate-500 mt-4">No applications in this period yet.</p>
                <% } else { %>
                    <ol class="space-y-2.5 mt-4">
                        <% steps.forEach(step => { %>
                            <li data-funnel="<%= step.status %>">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-semibold text-slate-700"><%= step.status %></span>
                                    <span class="tabular-nums text-slate-600"><%= fmt(step.reached) %><% if (step.conversion !== null) { %> <span class="text-slate-400">· <%= step.conversion %>% of the step before</span><% } %></span>
                                </div>
                                <div class="h-2.5 bg-slate-100 rounded-full mt-1 overflow-hidden">
                                    <div class="h-full bg-indigo-500 rounded-full" style="width: <%= share(step.reached, funnelTop) %>%"></div>
                                </div>
                            </li>
                        <% }) %>
                    </ol>
                    <p class="text-[11px] text-slate-500 mt-3 flex flex-wrap gap-x-4">
                        <span>Rejected: <strong class="text-slate-700"><%= fmt(data.funnel.exits.Rejected) %></strong></span>
                        <span>Withdrawn: <strong class="text-slate-700"><%= fmt(data.funnel.exits.Withdrawn) %></strong></span>
                    </p>
                <% } %>
            </section>

            <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm" aria-labelledby="stateTitle">
                <h2 id="stateTitle" class="text-sm font-bold text-slate-900">Applications by state</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Based on the candidate's profile. Top 10.</p>
                <% if (!data.states.length) { %>
                    <p class="text-xs text-slate-500 mt-4">No applications in this period yet.</p>
                <% } else { %>
                    <ul class="space-y-2 mt-4">
                        <% data.states.forEach(s => { %>
                            <li class="text-xs">
                                <div class="flex justify-between"><span class="font-semibold text-slate-700"><%= s.state %></span><span class="tabular-nums text-slate-600"><%= fmt(s.applications) %></span></div>
                                <div class="h-2 bg-slate-100 rounded-full mt-1 overflow-hidden"><div class="h-full bg-emerald-500 rounded-full" style="width: <%= share(s.applications, stateTop) %>%"></div></div>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </section>
        </div>

        <section class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden" aria-labelledby="topTitle">
            <div class="p-5 pb-3">
                <h2 id="topTitle" class="text-sm font-bold text-slate-900">Top listings</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Most applications in this period.</p>
            </div>
            <% if (!data.listings.length) { %>
                <p class="text-xs text-slate-500 px-5 pb-5">No applications in this period yet.</p>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-500">
                            <tr><th class="px-5 py-2">Listing</th><th class="px-3 py-2">Applications</th><th class="px-3 py-2">Hired</th><th class="px-3 py-2">Openings filled</th></tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% data.listings.forEach(l => { %>
                                <tr>
                                    <td class="px-5 py-2.5"><span class="block font-semibold text-slate-800"><%= l.title %></span><span class="block text-[11px] text-slate-500"><%= l.company %><%= l.status ? ' · ' + l.status : '' %></span></td>
                                    <td class="px-3 py-2.5 tabular-nums"><%= fmt(l.applications) %></td>
                                    <td class="px-3 py-2.5 tabular-nums"><%= fmt(l.hired) %></td>
                                    <td class="px-3 py-2.5 tabular-nums"><%= l.openings ? share(Math.min(l.hired, l.openings), l.openings) + '%' : '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <div class="grid xl:grid-cols-2 gap-5">
            <section class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden" aria-labelledby="skillsTitle">
                <div class="p-5 pb-3">
                    <h2 id="skillsTitle" class="text-sm font-bold text-slate-900">Skills gap</h2>
                    <p class="text-[11px] text-slate-500 mt-0.5">Skills live listings ask for most, against how many candidates list them.</p>
                </div>
                <% if (!data.skills.length) { %>
                    <p class="text-xs text-slate-500 px-5 pb-5">No live listings with required skills yet.</p>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-500">
                                <tr><th class="px-5 py-2">Skill</th><th class="px-3 py-2">Listings</th><th class="px-3 py-2">Candidates</th><th class="px-3 py-2">Per listing</th></tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% data.skills.forEach(s => { const tag = supplyTag(s.perListing); %>
                                    <tr data-skill="<%= s.skill %>">
                                        <td class="px-5 py-2 font-semibold text-slate-800"><%= s.skill %></td>
                                        <td class="px-3 py-2 tabular-nums"><%= fmt(s.listings) %></td>
                                        <td class="px-3 py-2 tabular-nums"><%= fmt(s.candidates) %></td>
                                        <td class="px-3 py-2"><span class="tabular-nums"><%= s.perListing %></span> <span class="ml-1 px-1.5 py-0.5 rounded text-[10px] font-semibold <%= tag.cls %>"><%= tag.text %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm" aria-labelledby="pmisTitle">
                <h2 id="pmisTitle" class="text-sm font-bold text-slate-900">PMIS eligibility</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Every candidate checked against the scheme rules<%= data.pmis.capped ? ' (first ' + fmt(data.pmis.scanned) + ')' : '' %>.</p>
                <% if (!pmisTotal) { %>
                    <p class="text-xs text-slate-500 mt-4">No candidates yet.</p>
                <% } else { %>
                    <div class="flex h-3 rounded-full overflow-hidden mt-4" aria-hidden="true">
                        <div class="bg-emerald-500" style="width: <%= share(data.pmis.eligible, pmisTotal) %>%"></div>
                        <div class="bg-rose-400" style="width: <%= share(data.pmis.ineligible, pmisTotal) %>%"></div>
                        <div class="bg-amber-300" style="width: <%= share(data.pmis.incomplete, pmisTotal) %>%"></div>
                    </div>
                    <dl class="grid grid-cols-3 gap-3 mt-4 text-xs">
                        <div data-pmis="eligible"><dt class="flex items-center gap-1.5 text-slate-500"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>Eligible</dt><dd class="text-lg font-bold text-slate-900"><%= fmt(data.pmis.eligible) %> <span class="text-xs font-normal text-slate-500"><%= share(data.pmis.eligible, pmisTotal) %>%</span></dd></div>
                        <div data-pmis="ineligible"><dt class="flex items-center gap-1.5 text-slate-500"><span class="w-2 h-2 rounded-full bg-rose-400"></span>Not eligible</dt><dd class="text-lg font-bold text-slate-900"><%= fmt(data.pmis.ineligible) %> <span class="text-xs font-normal text-slate-500"><%= share(data.pmis.ineligible, pmisTotal) %>%</span></dd></div>
                        <div data-pmis="incomplete"><dt class="flex items-center gap-1.5 text-slate-500"><span class="w-2 h-2 rounded-full bg-amber-300"></span>Profile incomplete</dt><dd class="text-lg font-bold text-slate-900"><%= fmt(data.pmis.incomplete) %> <span class="text-xs font-normal text-slate-500"><%= share(data.pmis.incomplete, pmisTotal) %>%</span></dd></div>
                    </dl>
                <% } %>
            </section>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const canvas = document.getElementById('trendChart');
        if (!canvas || !window.Chart) return;
        // "<" is escaped so data can't close this script block.
        const SERIES = <%- JSON.stringify(data.series).replace(/</g, '\\u003c') %>;
        const line = (label, values, color) => ({
            label,
            data: values,
            borderColor: color,
            backgroundColor: color + '22',
            fill: true,
            tension: 0.3,
            pointRadius: SERIES.labels.length > 45 ? 0 : 2
        });
        new window.Chart(canvas, {
            type: 'line',
            data: {
                labels: SERIES.labels.map(day => day.slice(5)),
                datasets: [line('Sign-ups', SERIES.signups, '#4f46e5'), line('Applications', SERIES.applications, '#059669')]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { ticks: { maxTicksLimit: 10 } } }
            }
        });
    })();
</script>
