<% layout('layouts/boilerplate') %>
<%
    const severityClass = {
        high: 'bg-rose-50 text-rose-700 border-rose-200',
        medium: 'bg-amber-50 text-amber-800 border-amber-200',
        low: 'bg-slate-50 text-slate-600 border-slate-200'
    };
    const statusClass = {
        published: 'bg-emerald-50 text-emerald-700 border-emerald-200',
        paused: 'bg-amber-50 text-amber-800 border-amber-200',
        closed: 'bg-slate-100 text-slate-600 border-slate-200',
        draft: 'bg-slate-50 text-slate-500 border-slate-200'
    };
    const chip = (label, value, count) => ({ label, value, count, active: filters.risk === value });
    const riskChips = [
        chip('All', '', counts.all),
        chip('Flagged', 'flagged', counts.high + counts.medium + counts.low),
        chip('Medium and up', 'medium', counts.high + counts.medium),
        chip('High risk', 'high', counts.high)
    ];
    const chipHref = value => '/admin/listings?' + new URLSearchParams({ status: filters.status, q: filters.q, risk: value }).toString();
    const inr = n => Number.isFinite(Number(n)) ? '₹' + Number(n).toLocaleString('en-IN') : String(n);
%>

<div class="max-w-7xl mx-auto lg:grid lg:grid-cols-[210px_minmax(0,1fr)] gap-6">
    <%- include('_nav') %>

    <div class="min-w-0 space-y-5">
        <div class="border-b border-slate-200 pb-4">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Listing moderation</h1>
            <p class="text-xs text-slate-500 mt-0.5">Flags point at listings worth a look; nothing is hidden automatically. Pausing or closing tells the company why.</p>
        </div>

        <form method="GET" action="/admin/listings" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 flex flex-wrap items-end gap-3">
            <label class="text-xs text-slate-600 flex flex-col gap-1 grow min-w-[12rem]">Search
                <input type="search" name="q" value="<%= filters.q %>" placeholder="Title or company"
                    class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </label>
            <label class="text-xs text-slate-600 flex flex-col gap-1">Status
                <select name="status" class="px-2 py-2 text-xs border border-slate-200 rounded-lg bg-white">
                    <% [['published', 'Live'], ['paused', 'Paused'], ['closed', 'Closed'], ['draft', 'Draft'], ['all', 'Any status']].forEach(([value, label]) => { %>
                        <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option>
                    <% }) %>
                </select>
            </label>
            <input type="hidden" name="risk" value="<%= filters.risk %>">
            <button type="submit" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">Apply</button>
        </form>

        <nav class="flex flex-wrap gap-2" aria-label="Risk filter">
            <% riskChips.forEach(c => { %>
                <a href="<%= chipHref(c.value) %>" <%= c.active ? 'aria-current=page' : '' %>
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-semibold <%= c.active ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
                    <%= c.label %> <span class="tabular-nums opacity-80" data-risk-count="<%= c.value || 'all' %>"><%= c.count %></span>
                </a>
            <% }) %>
        </nav>

        <% if (!items.length) { %>
            <div class="bg-white border border-slate-200 rounded-xl p-10 text-center shadow-sm">
                <p class="text-sm font-semibold text-slate-700">No listings match these filters.</p>
            </div>
        <% } else { %>
            <ul class="space-y-3">
                <% items.forEach(l => { %>
                    <li class="bg-white border <%= l.risk === 'high' ? 'border-rose-200' : 'border-slate-200' %> rounded-xl shadow-sm p-4" data-listing="<%= l._id %>" data-risk="<%= l.risk %>">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-slate-900 break-words"><%= l.title || 'Untitled listing' %></p>
                                <p class="text-[11px] text-slate-500 mt-0.5">
                                    <%= l.companyName || 'Unknown company' %>
                                    <% if (l.owner) { %>· <a href="/admin/users/<%= l.owner._id %>" class="text-indigo-600 hover:underline">company account</a><% } %>
                                    · <%= [l.location && l.location.district, l.location && l.location.state].filter(Boolean).join(', ') || 'No location' %>
                                </p>
                            </div>
                            <span class="shrink-0 px-2 py-0.5 rounded-full border text-[10px] font-semibold <%= statusClass[l.status] || statusClass.draft %>"><%= l.status %></span>
                        </div>
                        <p class="text-[11px] text-slate-600 mt-2 flex flex-wrap gap-x-4 gap-y-1">
                            <span><%= inr(l.monthlyStipend) %> / month</span>
                            <span><%= l.vacancies %> openings</span>
                            <span><%= l.duration || 'No duration' %></span>
                        </p>
                        <% if (l.flags.length) { %>
                            <ul class="flex flex-wrap gap-1.5 mt-2" aria-label="Risk flags">
                                <% l.flags.forEach(f => { %>
                                    <li class="px-2 py-0.5 rounded-md border text-[10px] font-semibold <%= severityClass[f.severity] %>" data-flag="<%= f.id %>"><%= f.label %></li>
                                <% }) %>
                            </ul>
                        <% } %>

                        <% if (['published', 'paused', 'closed'].includes(l.status)) { %>
                            <details class="mt-3">
                                <summary class="cursor-pointer text-xs font-semibold text-indigo-600">Moderate</summary>
                                <form action="/admin/listings/<%= l._id %>/moderate" method="POST" class="mt-2 flex flex-wrap items-end gap-2">
                                    <input type="hidden" name="back" value="<%= currentUrl %>">
                                    <label class="text-xs text-slate-600 flex flex-col gap-1 grow min-w-[14rem]">Reason for the company
                                        <input name="reason" maxlength="1000" placeholder="Needed to pause or close, at least 10 characters"
                                            class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                                    </label>
                                    <% if (l.status === 'published') { %>
                                        <button name="action" value="pause" class="px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg">Pause</button>
                                    <% } %>
                                    <% if (l.status !== 'closed') { %>
                                        <button name="action" value="close" class="px-3 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg">Close</button>
                                    <% } %>
                                    <% if (l.status !== 'published') { %>
                                        <button name="action" value="restore" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg">Restore</button>
                                    <% } %>
                                </form>
                            </details>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <% if (scanned >= scanLimit) { %>
            <p class="text-[11px] text-slate-400">Flags are worked out for the newest <%= scanLimit %> listings with this status. Narrow the search to reach older ones.</p>
        <% } %>
        <%- include('_pager', { pagerBase: '/admin/listings', pagerParams: { status: filters.status, risk: filters.risk, q: filters.q } }) %>
    </div>
</div>
