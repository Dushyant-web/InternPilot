<% layout('layouts/boilerplate') %>

    <div class="space-y-6">

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">

                <div class="space-y-3">
                    <div class="flex items-center space-x-3">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                            <%= user.name %>
                        </h1>
                        <span class="text-sm font-medium text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-md">
                            Age: <%= user.age %>
                        </span>
                    </div>

                    <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-sm text-slate-600">
                        <span class="flex items-center gap-1.5">
                            <i class="ph-bold ph-map-pin text-indigo-500"></i>
                            <%= user.location.district %>, <%= user.location.state %>
                        </span>
                        <span class="flex items-center gap-1.5">
                            <i class="ph-bold ph-graduation-cap text-indigo-500"></i>
                            <%= user.education.qualification %> (<%= user.education.institutionName %>)
                        </span>
                        <span class="flex items-center gap-1.5">
                            <i class="ph-bold ph-currency-inr text-emerald-600"></i>
                            Income: ₹<%= user.familyIncome.toLocaleString('en-IN') %>/yr
                        </span>
                    </div>

                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <% user.skills.forEach(skill=> { %>
                            <span
                                class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">
                                <%= skill %>
                            </span>
                            <% }) %>
                    </div>
                </div>

                <div class="shrink-0">
                    <% if (eligibility.isEligible) { %>
                        <div
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 font-semibold text-sm">
                            <i class="ph-fill ph-check-circle text-emerald-600 text-lg"></i>
                            PMIS Eligible
                        </div>
                        <% } else { %>
                            <div
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-50 border border-rose-200 text-rose-800 font-semibold text-sm">
                                <i class="ph-fill ph-warning-circle text-rose-600 text-lg"></i>
                                Scheme Ineligible
                            </div>
                            <% } %>
                </div>
            </div>

            <% if (!eligibility.isEligible) { %>
                <div class="mt-6 rounded-xl bg-rose-50 border border-rose-200 p-4 text-rose-900 text-sm space-y-1">
                    <div class="font-bold flex items-center gap-1.5">
                        <i class="ph-bold ph-x-circle text-rose-600"></i> Gate Rule Failure
                    </div>
                    <ul class="list-disc list-inside space-y-0.5 text-rose-700 pl-1">
                        <% eligibility.reasons.forEach(reason=> { %>
                            <li>
                                <%= reason %>
                            </li>
                            <% }) %>
                    </ul>
                </div>
                <% } %>
        </div>


        <div class="flex items-center justify-between pt-2">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <i class="ph-bold ph-sparkle text-amber-500"></i> Recommended Internships
            </h2>
            <span class="text-sm font-medium text-slate-500">
                <%= recommendations.length %> Matched Opportunities
            </span>
        </div>

        <% if (recommendations.length===0) { %>
            <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-500">
                <i class="ph-bold ph-magnifying-glass text-4xl mb-2 text-slate-400"></i>
                <p>No matching internships found matching district or educational qualification.</p>
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    <% recommendations.forEach(rec=> { %>
                        <div
                            class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between p-5">

                            <div class="space-y-3">
                                <div class="flex items-center justify-between gap-2">
                                    <span
                                        class="text-xs font-semibold tracking-wider uppercase bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md border border-slate-200 truncate">
                                        <%= rec.role.sector %>
                                    </span>
                                    <span
                                        class="shrink-0 text-xs font-bold bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-md border border-emerald-200">
                                        <%= rec.matchScore %>% Match
                                    </span>
                                </div>

                                <div>
                                    <h3 class="font-bold text-slate-900 text-lg leading-snug line-clamp-1">
                                        <%= rec.role.title %>
                                    </h3>
                                    <p class="text-sm font-medium text-slate-500">
                                        <%= rec.role.companyName %>
                                    </p>
                                </div>

                                <div class="text-xs space-y-1.5 text-slate-600 border-y border-slate-100 py-3">
                                    <div class="flex items-center gap-2">
                                        <i class="ph-bold ph-map-pin text-rose-500"></i>
                                        <span>
                                            <%= rec.role.location.district %>, <%= rec.role.location.state %>
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-bold ph-graduation-cap text-indigo-500"></i>
                                        <span>Min Qualification: <strong class="text-slate-800">
                                                <%= rec.role.minQualification %>
                                            </strong></span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="ph-bold ph-currency-inr text-emerald-600"></i>
                                        <span>Stipend: <strong class="text-slate-800">₹<%=
                                                    rec.role.monthlyStipend.toLocaleString('en-IN') %>
                                                    /mo</strong></span>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">
                                        Required Skills</p>
                                    <div class="flex flex-wrap gap-1">
                                        <% rec.role.requiredSkills.forEach(skill=> { %>
                                            <span
                                                class="px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                                <%= skill %>
                                            </span>
                                            <% }) %>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-5 mt-auto">
                                <% if (eligibility.isEligible) { %>
                                    <button
                                        class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl transition-colors shadow-sm shadow-indigo-200">
                                        Apply Now
                                    </button>
                                    <% } else { %>
                                        <button disabled
                                            class="w-full py-2.5 px-4 bg-slate-100 text-slate-400 font-medium text-sm rounded-xl cursor-not-allowed border border-slate-200">
                                            Ineligible to Apply
                                        </button>
                                        <% } %>
                            </div>

                        </div>
                        <% }) %>
                </div>
                <% } %>

    </div>