<% layout('layouts/boilerplate') %>

    <div class="max-w-3xl mx-auto px-4 py-8">
        <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm space-y-6">
            <div class="flex justify-between items-center border-b pb-4">
                <h2 class="text-xl font-bold text-slate-900">Edit Internship Opportunity</h2>
                <a href="/company/dashboard" class="text-xs font-semibold text-indigo-600 hover:underline">&larr; Back
                    to Dashboard</a>
            </div>

            <form action="/company/internships/edit/<%= internship._id %>" method="POST" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Internship Title</label>
                    <input type="text" name="title" value="<%= internship.title %>" required
                        class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Sector</label>
                        <input type="text" name="sector" value="<%= internship.sector %>"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Vacancies</label>
                        <input type="number" name="vacancies" value="<%= internship.vacancies %>" min="1"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Required Skills (Comma Separated)</label>
                    <input type="text" name="requiredSkills"
                        value="<%= internship.requiredSkills ? internship.requiredSkills.join(', ') : '' %>"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Min Qualifications</label>
                    <input type="text" name="minQualifications" value="<%= internship.minQualifications %>"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Monthly Stipend (₹)</label>
                        <input type="number" name="monthlyStipend" value="<%= internship.monthlyStipend %>"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Duration</label>
                        <input type="text" name="duration" value="<%= internship.duration || '12 Months' %>"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Application Deadline (Optional)</label>
                    <input type="date" name="deadline"
                        value="<%= internship.applicationDeadline ? internship.applicationDeadline.toISOString().split('T')[0] : '' %>"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300 text-slate-600">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">District</label>
                        <input type="text" name="district" value="<%= internship.location?.district %>"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">State</label>
                        <input type="text" name="state" value="<%= internship.location?.state %>"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t">
                    <a href="/company/dashboard"
                        class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition-colors">
                        Cancel
                    </a>
                    <button type="submit"
                        class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors shadow-sm">
                        Update Opportunity
                    </button>
                </div>
            </form>
        </div>
    </div>