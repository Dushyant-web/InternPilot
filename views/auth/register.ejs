<% layout('layouts/boilerplate') %>

    <div class="max-w-lg mx-auto my-10 bg-white p-8 rounded-xl shadow-md border border-gray-100">
        <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Create an Account</h2>

        <form action="/auth/register" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                <input type="text" name="name" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
                    placeholder="John Doe">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
                <input type="email" name="email" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
                    placeholder="user@example.com">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                <input type="password" name="password" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
                    placeholder="••••••••">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">I am registering as a:</label>
                <select name="role" id="roleSelect" required onchange="handleRoleChange(this.value)"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition bg-white">
                    <option value="candidate" selected>Candidate (Looking for internships)</option>
                    <option value="company">Company (Posting internships)</option>
                    <option value="admin">Administrator (System Portal Admin)</option>
                </select>
            </div>

            <!-- Admin Security Key Field  -->
            <div id="adminSecretField" class="hidden p-3 bg-amber-50 border border-amber-200 rounded-lg">
                <label class="block text-xs font-semibold text-amber-800 uppercase tracking-wider mb-1">
                    Admin Authorization Passcode
                </label>
                <input type="password" name="adminSecretKey" placeholder="Enter system authorization code"
                    class="w-full px-4 py-2 border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500 outline-none transition text-sm">
            </div>

            <!-- Optional Company Fields  -->
            <div id="companyFields" class="hidden space-y-4 pt-2 border-t border-gray-100">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
                    <input type="text" name="companyName" placeholder="Acme Corp"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">CIN Number</label>
                        <input type="text" name="cin" placeholder="L12345MH2020PLC123456"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Industry</label>
                        <input type="text" name="industry" placeholder="IT, Finance, etc."
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                </div>
            </div>

            <button type="submit"
                class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-lg shadow transition duration-200">
                Sign Up
            </button>
        </form>

        <div class="relative flex py-5 items-center">
            <div class="flex-grow border-t border-gray-200"></div>
            <span class="flex-shrink mx-4 text-xs text-gray-400 uppercase tracking-wider">Or</span>
            <div class="flex-grow border-t border-gray-200"></div>
        </div>

        <a href="/auth/google"
            class="w-full flex items-center justify-center gap-3 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2.5 rounded-lg transition duration-200 shadow-sm">
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <g>
                    <path fill="#EA4335"
                        d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z">
                    </path>
                    <path fill="#4285F4"
                        d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                    </path>
                    <path fill="#FBBC05"
                        d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z">
                    </path>
                    <path fill="#34A853"
                        d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z">
                    </path>
                    <path fill="none" d="M0 0h48v48H0z"></path>
                </g>
            </svg>
            <span>Sign up with Google</span>
        </a>

        <p class="text-center text-sm text-gray-600 mt-6">
            Already have an account?
            <a href="/auth/login" class="text-emerald-600 hover:underline font-semibold">Log in here</a>
        </p>
    </div>

    <script>
        function handleRoleChange(role) {
            const companyFields = document.getElementById('companyFields');
            const adminSecretField = document.getElementById('adminSecretField');

            if (role === 'company') {
                companyFields.classList.remove('hidden');
                adminSecretField.classList.add('hidden');
            } else if (role === 'admin') {
                adminSecretField.classList.remove('hidden');
                companyFields.classList.add('hidden');
            } else {
                companyFields.classList.add('hidden');
                adminSecretField.classList.add('hidden');
            }
        }
    </script>