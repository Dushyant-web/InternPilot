<% layout('layouts/boilerplate') %>

    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">PMIS Internship Listings</h2>
            <p class="text-xs text-slate-500 mt-1">
                Official opportunities posted by top partner organizations under the Prime Minister's Internship Scheme.
            </p>
        </div>

        <!-- Filter Tabs: All, Active, Paused -->
        <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl text-xs font-semibold self-start md:self-auto border border-slate-200">
            <a href="/internships?status=all"
                class="px-3 py-1.5 rounded-lg transition-colors <%= (typeof currentFilter === 'undefined' || currentFilter === 'all') ? 'bg-white text-indigo-700 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
                All Listings
            </a>
            <a href="/internships?status=active"
                class="px-3 py-1.5 rounded-lg transition-colors <%= (typeof currentFilter !== 'undefined' && currentFilter === 'active') ? 'bg-white text-emerald-700 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
                Active Openings
            </a>
            <a href="/internships?status=paused"
                class="px-3 py-1.5 rounded-lg transition-colors <%= (typeof currentFilter !== 'undefined' && currentFilter === 'paused') ? 'bg-white text-amber-700 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
                Applications Paused
            </a>
        </div>
    </div>

    <% if (!internships || internships.length === 0) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center text-slate-500">
            <i class="ph-bold ph-magnifying-glass text-3xl text-slate-400 mb-2"></i>
            <h3 class="font-bold text-slate-700 text-base">No listings found</h3>
            <p class="text-xs text-slate-400 mt-1">
                <%= typeof currentFilter !== 'undefined' && currentFilter === 'paused' ? 'There are currently no paused internship listings.' : 'No internships match your current filter.' %>
            </p>
            <a href="/internships?status=all" class="mt-4 inline-block px-4 py-2 bg-indigo-50 text-indigo-700 font-semibold text-xs rounded-lg hover:bg-indigo-100 transition-colors">
                View All Listings
            </a>
        </div>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% internships.forEach(item=> { %>
            <% const isItemPaused = item.status === 'paused' || item.isPaused; %>
            <div
                class="bg-white border <%= isItemPaused ? 'border-amber-300' : 'border-slate-200' %> rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between relative group">

                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span
                                class="text-[11px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-full">
                                <%= item.sector || "General" %>
                            </span>
                            <% if (isItemPaused) { %>
                                <span
                                    class="text-[11px] font-bold text-amber-800 bg-amber-100 border border-amber-300 px-2 py-0.5 rounded-full flex items-center gap-1">
                                    <i class="ph-bold ph-pause-circle"></i> Paused
                                </span>
                            <% } %>
                        </div>

                        <div class="flex items-center gap-2">
                            <span
                                class="text-[11px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded">
                                <%= item.vacancies || 1 %> Openings
                            </span>

                            <!-- Show Edit/Pause/Delete ONLY if Admin OR if logged in as the owning Company -->
                            <% if (currentUser && (currentUser.role==='admin' || ((currentUser.role==='company' || currentUser.role==='recruiter') &&
                                item.companyId && currentUser.companyId && item.companyId.toString()===currentUser.companyId.toString()))) { %>
                                <% if (isItemPaused) { %>
                                    <form action="/internships/<%= item._id %>/resume" method="POST" class="inline" title="Resume Applications">
                                        <button type="submit" class="text-amber-600 hover:text-emerald-600 transition-colors cursor-pointer p-0.5" title="Resume Applications">
                                            <i class="ph-bold ph-play text-sm"></i>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/internships/<%= item._id %>/pause" method="POST" class="inline" title="Pause Applications">
                                        <button type="submit" class="text-slate-400 hover:text-amber-600 transition-colors cursor-pointer p-0.5" title="Pause Applications">
                                            <i class="ph-bold ph-pause text-sm"></i>
                                        </button>
                                    </form>
                                <% } %>

                                <button onclick="openEditModal(this)" data-item='<%= JSON.stringify(item) %>'
                                    class="text-slate-400 hover:text-indigo-600 transition-colors cursor-pointer p-0.5"
                                    title="Edit">
                                    <i class="ph-bold ph-pencil-simple text-sm"></i>
                                </button>

                                <form action="/internships/<%= item._id %>/delete" method="POST"
                                    onsubmit="return confirm('Delete this internship?');" class="inline" data-loading-text="Deleting...">
                                    <button type="submit"
                                        class="text-slate-400 hover:text-rose-600 transition-colors cursor-pointer p-0.5"
                                        title="Delete">
                                        <i class="ph-bold ph-trash text-sm"></i>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>

                    <h3 class="text-base font-bold text-slate-900 leading-snug">
                        <a href="/internships/<%= item._id %>" class="hover:text-indigo-600 transition-colors">
                            <%= item.title %>
                        </a>
                    </h3>
                    <p class="text-xs font-semibold text-slate-600 mt-0.5 flex items-center gap-1">
                        <i class="ph-bold ph-buildings text-slate-400"></i>
                        <%= item.companyName || item.company %>
                    </p>

                    <div
                        class="my-4 p-3 bg-slate-50 border border-slate-100 rounded-lg text-xs space-y-1.5 text-slate-600">
                        <div class="flex items-center gap-1.5">
                            <i class="ph-bold ph-map-pin text-rose-500"></i>
                            <span>
                                <%= typeof item.location==='object' && item.location !==null ? ((item.location.district
                                    ? item.location.district + ', ' : '' ) + (item.location.state || '' )) :
                                    (item.location || 'Location Not Specified' ) %>
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5">
                                <i class="ph-bold ph-currency-inr text-emerald-600"></i>
                                <strong class="text-slate-800">
                                    ₹<%= Number(item.monthlyStipend ?? 5000).toLocaleString('en-IN') %> / month
                                </strong>
                            </span>
                            <span class="text-slate-400">&bull;</span>
                            <span class="flex items-center gap-1 text-slate-500">
                                <i class="ph-bold ph-clock"></i>
                                <%= item.duration || "12 Months" %>
                            </span>
                        </div>
                        <% if (item.applicationDeadline) { %>
                        <div class="flex items-center justify-between mt-1.5 pt-1.5 border-t border-slate-100">
                            <span class="flex items-center gap-1.5 <%= new Date() > item.applicationDeadline ? 'text-rose-600 font-semibold' : 'text-slate-500' %>">
                                <i class="ph-bold ph-calendar-blank"></i>
                                Apply By: <%= new Date(item.applicationDeadline).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                            </span>
                        </div>
                        <% } %>
                        <% if (isItemPaused) { %>
                        <div class="flex items-center gap-1.5 mt-1.5 pt-1.5 border-t border-amber-200 text-amber-800 font-semibold text-xs bg-amber-50/80 px-2 py-1 rounded">
                            <i class="ph-bold ph-pause-circle text-amber-600 text-sm"></i>
                            <span>Applications are temporarily paused.</span>
                        </div>
                        <% } %>
                    </div>

                    <div class="mb-4">
                        <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">Required
                            Skills</p>
                        <div class="flex flex-wrap gap-1.5">
                            <% if (Array.isArray(item.requiredSkills)) { %>
                                <% item.requiredSkills.forEach(skill=> { %>
                                    <span
                                        class="text-xs font-medium text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200">
                                        <%= skill %>
                                    </span>
                                    <% }) %>
                                        <% } %>
                        </div>
                    </div>
                </div>

                <!-- ACTION BUTTON AREA (HIDDEN FOR COMPANY, RECRUITER, & ADMIN ROLES) -->
                <% if (!currentUser || (currentUser.role !=='company' && currentUser.role !=='admin' && currentUser.role !=='recruiter' )) { %>
                    <div class="pt-2">
                        <% if (!currentUser) { %>
                            <!-- 1. NOT LOGGED IN -> Redirect to Login Page or show Paused -->
                            <% if (isItemPaused) { %>
                                <button disabled
                                    class="w-full text-center py-2 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 cursor-not-allowed"
                                    title="Applications for this position are temporarily paused.">
                                    <i class="ph-bold ph-pause-circle text-base"></i> Applications Paused
                                </button>
                            <% } else { %>
                                <a href="/auth/login"
                                    class="w-full text-center py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                    <i class="ph-bold ph-paper-plane-tilt"></i> Apply Now
                                </a>
                            <% } %>
                        <% } else if (typeof appliedIds !=='undefined' && appliedIds.includes(item._id.toString())) { %>
                            <!-- 2. LOGGED IN CANDIDATE & ALREADY APPLIED -->
                            <button disabled
                                class="w-full text-center py-2 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 cursor-not-allowed">
                                <i class="ph-bold ph-check-circle text-base"></i> Applied
                            </button>
                        <% } else if (isItemPaused) { %>
                            <!-- 3. LOGGED IN CANDIDATE & APPLICATIONS PAUSED -->
                            <button disabled
                                class="w-full text-center py-2 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 cursor-not-allowed"
                                title="The recruiter has temporarily paused new applications for this position.">
                                <i class="ph-bold ph-pause-circle text-base"></i> Applications Paused
                            </button>
                        <% } else if (item.applicationDeadline && new Date() > item.applicationDeadline) { %>
                            <!-- 4. DEADLINE PASSED -->
                            <button disabled
                                class="w-full text-center py-2 bg-rose-50 text-rose-700 border border-rose-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 cursor-not-allowed">
                                <i class="ph-bold ph-x-circle text-base"></i> Applications Closed
                            </button>
                        <% } else { %>
                            <!-- 5. LOGGED IN CANDIDATE & HAS NOT APPLIED & OPEN -->
                            <form action="/internships/<%= item._id %>/apply" method="POST" class="w-full">
                                <button type="submit"
                                    class="w-full text-center py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                    <i class="ph-bold ph-paper-plane-tilt"></i> Apply Now
                                </button>
                            </form>
                        <% } %>

                        <% if (currentUser && currentUser.role === 'candidate') { %>
                            <a href="/internships/<%= item._id %>/skill-gap"
                                class="mt-2 w-full text-center py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-semibold rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                <i class="ph-bold ph-chart-donut text-base text-indigo-600"></i>
                                Skill Gap Analysis
                            </a>
                        <% } %>
                    </div>
                <% } %>

            </div>
            <% }) %>
    </div>
    <% } %>

    <!-- POST NEW MODAL -->
    <div id="postingModal"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-xl max-w-lg w-full p-6 shadow-xl relative">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Post New Internship Listing</h3>
                    <p class="text-xs text-slate-500">Add an opportunity to match eligible candidates under PMIS.</p>
                </div>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <i class="ph-bold ph-x text-xl"></i>
                </button>
            </div>

            <form action="/internships/new" method="POST" class="mt-4 space-y-4" data-loading-text="Posting...">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Internship Role Title</label>
                    <input type="text" name="title" required placeholder="e.g. Quality Control Assistant"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Organization</label>
                        <input type="text" name="company" required placeholder="e.g. Tata Motors"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Industry Sector</label>
                        <input type="text" name="sector" required placeholder="e.g. Automotive"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Location (District,
                            State)</label>
                        <input type="text" name="location" required placeholder="e.g. Pune, Maharashtra"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Total Open Vacancies</label>
                        <input type="number" name="vacancies" min="1" value="5" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Stipend (₹)</label>
                        <input type="number" name="stipend" required placeholder="e.g. 10000" min="0" step="500"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Duration</label>
                        <input type="text" name="duration" placeholder="e.g. 12 Months"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Min Qualifications</label>
                    <input type="text" name="minQualifications" placeholder="e.g. B.Tech / Diploma / Any"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Required Skills (Comma
                        Separated)</label>
                    <input type="text" name="requiredSkills" required placeholder="e.g. Quality Control, Python"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Application Deadline (Optional)</label>
                    <input type="date" name="deadline"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-600">
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
                    <button type="button" onclick="closeModal()"
                        class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200">Cancel</button>
                    <button type="submit" name="action" value="draft" formnovalidate
                        class="px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-300">Save as Draft</button>
                    <button type="submit" name="action" value="publish"
                        class="px-4 py-2 text-xs font-semibold text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg shadow-sm">Publish
                        Listing</button>
                </div>
            </form>
        </div>
    </div>


    <div id="editModal"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-xl max-w-lg w-full p-6 shadow-xl relative">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Edit Internship Listing</h3>
                    <p class="text-xs text-slate-500">Update listing details for PMIS candidates.</p>
                </div>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <i class="ph-bold ph-x text-xl"></i>
                </button>
            </div>

            <form id="editForm" method="POST" class="mt-4 space-y-4" data-loading-text="Saving...">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Internship Role Title</label>
                    <input type="text" id="edit_title" name="title" required
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Organization</label>
                        <input type="text" id="edit_company" name="company" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Industry Sector</label>
                        <input type="text" id="edit_sector" name="sector" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Location (District,
                            State)</label>
                        <input type="text" id="edit_location" name="location" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Total Open Vacancies</label>
                        <input type="number" id="edit_vacancies" name="vacancies" min="1" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Stipend (₹)</label>
                        <input type="number" id="edit_stipend" name="stipend" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Duration</label>
                        <input type="text" id="edit_duration" name="duration"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Min Qualifications</label>
                    <input type="text" id="edit_minQualifications" name="minQualifications" placeholder="e.g. B.Tech / Diploma / Any"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Required Skills (Comma
                        Separated)</label>
                    <input type="text" id="edit_skills" name="requiredSkills" required
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Application Deadline (Optional)</label>
                    <input type="date" id="edit_deadline" name="deadline"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-600">
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
                    <button type="button" onclick="closeEditModal()"
                        class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200">Cancel</button>
                    <button type="submit"
                        class="px-4 py-2 text-xs font-semibold text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg shadow-sm">Save
                        Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal() {
            document.getElementById('postingModal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('postingModal').classList.add('hidden');
        }

        function openEditModal(button) {
            try {
                const item = JSON.parse(button.getAttribute('data-item'));
                document.getElementById('editForm').action = '/internships/' + item._id + '/edit';
                document.getElementById('edit_title').value = item.title || '';
                document.getElementById('edit_company').value = item.companyName || item.company || '';
                document.getElementById('edit_sector').value = item.sector || '';

                let locStr = '';
                if (typeof item.location === 'object' && item.location !== null) {
                    locStr = (item.location.district || '') + (item.location.state ? ', ' + item.location.state : '');
                } else {
                    locStr = item.location || '';
                }
                document.getElementById('edit_location').value = locStr;

                document.getElementById('edit_vacancies').value = item.vacancies || 1;
                document.getElementById('edit_stipend').value = item.monthlyStipend || 5000;
                document.getElementById('edit_duration').value = item.duration || '12 Months';
                document.getElementById('edit_minQualifications').value = item.minQualifications || item.minQualification || '';
                document.getElementById('edit_skills').value = Array.isArray(item.requiredSkills) ? item.requiredSkills.join(', ') : '';

                if (item.applicationDeadline) {
                    const dateObj = new Date(item.applicationDeadline);
                    if (!isNaN(dateObj.getTime())) {
                        document.getElementById('edit_deadline').value = dateObj.toISOString().split('T')[0];
                    } else {
                        document.getElementById('edit_deadline').value = '';
                    }
                } else {
                    document.getElementById('edit_deadline').value = '';
                }

                document.getElementById('editModal').classList.remove('hidden');
            } catch (err) {
                console.error('Error parsing item data:', err);
            }
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }
    </script>