<% layout('layouts/boilerplate') %>

    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">PMIS Internship Listings</h2>
            <p class="text-xs text-slate-500 mt-1">
                Official opportunities posted by top partner organizations under the Prime Minister's Internship Scheme.
            </p>
        </div>

        <% if (currentUser && (currentUser.role === 'company' || currentUser.role === 'admin')) { %>
            <button onclick="openModal()" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors flex items-center gap-1.5 self-start md:self-auto">
                <i class="ph-bold ph-plus text-sm"></i> Post New Listing
            </button>
        <% } %>
    </div>

    <!-- Search, Filter & Sort Bar -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-6 shadow-sm">
        <form action="/internships" method="GET" class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3">
                <!-- Search Input -->
                <div class="lg:col-span-4 relative">
                    <i class="ph-bold ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                    <input type="text" name="search" value="<%= queryState ? (queryState.search || '') : '' %>" placeholder="Search title, company, skills..."
                        class="w-full pl-9 pr-3 py-2 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-slate-50 focus:bg-white transition-colors" />
                </div>

                <!-- Sector Filter -->
                <div class="lg:col-span-3">
                    <select name="sector" class="w-full px-3 py-2 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-slate-50 focus:bg-white transition-colors cursor-pointer">
                        <option value="">All Sectors</option>
                        <% if (typeof sectors !== 'undefined' && Array.isArray(sectors)) { %>
                            <% sectors.forEach(sec => { %>
                                <option value="<%= sec %>" <%= (queryState && queryState.sector && queryState.sector.toLowerCase() === sec.toLowerCase()) ? 'selected' : '' %>><%= sec %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <!-- Location Filter -->
                <div class="lg:col-span-3 relative">
                    <i class="ph-bold ph-map-pin absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                    <input type="text" name="location" value="<%= queryState ? (queryState.location || '') : '' %>" placeholder="District or State..."
                        class="w-full pl-9 pr-3 py-2 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-slate-50 focus:bg-white transition-colors" />
                </div>

                <!-- Sort Selection -->
                <div class="lg:col-span-2">
                    <select name="sort" class="w-full px-3 py-2 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-slate-50 focus:bg-white transition-colors cursor-pointer">
                        <option value="latest" <%= (queryState && queryState.sort === 'latest') ? 'selected' : '' %>>Sort: Latest</option>
                        <option value="stipend_high" <%= (queryState && queryState.sort === 'stipend_high') ? 'selected' : '' %>>Stipend: High to Low</option>
                        <option value="stipend_low" <%= (queryState && queryState.sort === 'stipend_low') ? 'selected' : '' %>>Stipend: Low to High</option>
                        <option value="vacancies" <%= (queryState && queryState.sort === 'vacancies') ? 'selected' : '' %>>Most Vacancies</option>
                    </select>
                </div>

            </div>

            <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-2">
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer">
                        <i class="ph-bold ph-funnel"></i> Apply Filters
                    </button>
                    <% if (queryState && (queryState.search || queryState.sector || queryState.location || (queryState.sort && queryState.sort !== 'latest') || (queryState.page && queryState.page > 1))) { %>
                        <a href="/internships" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 font-semibold rounded-lg transition-colors flex items-center gap-1">
                            <i class="ph-bold ph-x text-xs"></i> Reset Filters
                        </a>
                    <% } %>
                </div>
                <span class="text-slate-500 font-medium">
                    Showing <%= pagination ? pagination.totalItems : (internships ? internships.length : 0) %> <%= (pagination && pagination.totalItems === 1) ? 'Opportunity' : 'Opportunities' %>
                </span>
            </div>
        </form>
    </div>

    <% if (!internships || internships.length === 0) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm my-6">
            <i class="ph-bold ph-magnifying-glass text-4xl text-slate-300 mb-2"></i>
            <h3 class="text-base font-bold text-slate-800">No matching internships found</h3>
            <p class="text-xs text-slate-500 mt-1 mb-4">Try relaxing your search terms or clearing filters.</p>
            <a href="/internships" class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors">
                Reset All Filters
            </a>
        </div>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% internships.forEach(item=> { %>
            <div
                class="internship-card bg-white border border-slate-200 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between relative group"
                data-stipend="<%= item.monthlyStipend || 5000 %>"
                data-duration="<%= parseInt(item.duration) || 12 %>"
                data-posted="<%= item._id.getTimestamp().getTime() %>">

                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span
                            class="text-[11px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-full">
                            <%= item.sector || "General" %>
                        </span>

                        <div class="flex items-center gap-2">
                            <span
                                class="text-[11px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded">
                                <%= item.vacancies || 1 %> Openings
                            </span>

                            <!-- Show Edit/Delete ONLY if Admin OR if logged in as the owning Company -->
                            <% if (currentUser && (currentUser.role==='admin' || (currentUser.role==='company' &&
                                item.postedBy && item.postedBy.toString()===currentUser._id.toString()))) { %>
                                <button onclick="openEditModal(this)" data-item='<%= JSON.stringify(item) %>'
                                    class="text-slate-400 hover:text-indigo-600 transition-colors cursor-pointer p-0.5"
                                    title="Edit">
                                    <i class="ph-bold ph-pencil-simple text-sm"></i>
                                </button>

                                <form action="/internships/<%= item._id %>/delete" method="POST"
                                    onsubmit="return confirm('Delete this internship?');" class="inline">
                                    <button type="submit"
                                        class="text-slate-400 hover:text-rose-600 transition-colors cursor-pointer p-0.5"
                                        title="Delete">
                                        <i class="ph-bold ph-trash text-sm"></i>
                                    </button>
                                </form>
                                <% } %>
                        </div>
                    </div>

                    <h3 class="text-base font-bold text-slate-900 leading-snug">
                        <%= item.title %>
                    </h3>
                    <p class="text-xs font-semibold text-slate-600 mt-0.5 flex items-center gap-1">
                        <i class="ph-bold ph-buildings text-slate-400"></i>
                        <%= item.companyName || item.company %>
                    </p>

                    <div
                        class="my-4 p-3 bg-slate-50 border border-slate-100 rounded-lg text-xs space-y-1.5 text-slate-600">
                        <div class="flex items-center gap-1.5">
                            <i class="ph-bold ph-map-pin text-rose-500"></i>
                            <span>
                                <%= typeof item.location==='object' && item.location !==null ? ((item.location.district
                                    ? item.location.district + ', ' : '' ) + (item.location.state || '' )) :
                                    (item.location || 'Location Not Specified' ) %>
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="flex items-center gap-1.5">
                                <i class="ph-bold ph-currency-inr text-emerald-600"></i>
                                <strong class="text-slate-800">
                                    ₹<%= item.monthlyStipend ? Number(item.monthlyStipend).toLocaleString('en-IN')
                                        : '5,000' %> / month
                                </strong>
                            </span>
                            <span class="text-slate-400">&bull;</span>
                            <span class="flex items-center gap-1 text-slate-500">
                                <i class="ph-bold ph-clock"></i>
                                <%= item.duration || "12 Months" %>
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">Required
                            Skills</p>
                        <div class="flex flex-wrap gap-1.5">
                            <% if (Array.isArray(item.requiredSkills)) { %>
                                <% item.requiredSkills.forEach(skill=> { %>
                                    <span
                                        class="text-xs font-medium text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200">
                                        <%= skill %>
                                    </span>
                                    <% }) %>
                                        <% } %>
                        </div>
                    </div>
                </div>

                <!-- ACTION BUTTON AREA (HIDDEN FOR COMPANY & ADMIN ROLES) -->
                <% if (!currentUser || (currentUser.role !=='company' && currentUser.role !=='admin' )) { %>
                    <div class="pt-2">
                        <% if (!currentUser) { %>
                            <!-- 1. NOT LOGGED IN -> Redirect to Login Page -->
                            <a href="/auth/login"
                                class="w-full text-center py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                <i class="ph-bold ph-paper-plane-tilt"></i> Apply Now
                            </a>
                            <% } else if (typeof appliedIds !=='undefined' && appliedIds.includes(item._id.toString()))
                                { %>
                                <!-- 2. LOGGED IN CANDIDATE & ALREADY APPLIED -->
                                <button disabled
                                    class="w-full text-center py-2 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 cursor-not-allowed">
                                    <i class="ph-bold ph-check-circle text-base"></i> Applied
                                </button>
                                <% } else { %>
                                    <!-- 3. LOGGED IN CANDIDATE & HAS NOT APPLIED -->
                                    <form action="/internships/<%= item._id %>/apply" method="POST" class="w-full">
                                        <button type="submit"
                                            class="w-full text-center py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                            <i class="ph-bold ph-paper-plane-tilt"></i> Apply Now
                                        </button>
                                    </form>
                                    <% } %>
                    </div>
                    <% } %>

            </div>
            <% }) %>
    </div>

    <!-- Pagination Controls Bar -->
    <% if (pagination && pagination.totalPages > 1) { %>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200 pt-4 text-xs">
            <div class="text-slate-500 font-medium">
                Showing Page <strong class="text-slate-800"><%= pagination.currentPage %></strong> of <strong class="text-slate-800"><%= pagination.totalPages %></strong>
            </div>
            <div class="flex items-center gap-1.5 flex-wrap">
                <% if (pagination.hasPrevPage) { %>
                    <a href="<%= buildQueryString(queryState, { page: pagination.prevPage }) %>" class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-100 text-slate-700 font-semibold transition-colors flex items-center gap-1">
                        &larr; Previous
                    </a>
                <% } else { %>
                    <span class="px-3 py-1.5 border border-slate-100 rounded-lg text-slate-300 font-semibold cursor-not-allowed">&larr; Previous</span>
                <% } %>

                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                    <% if (p === pagination.currentPage) { %>
                        <span class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg font-bold"><%= p %></span>
                    <% } else if (p === 1 || p === pagination.totalPages || Math.abs(p - pagination.currentPage) <= 1) { %>
                        <a href="<%= buildQueryString(queryState, { page: p }) %>" class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-100 text-slate-700 font-semibold transition-colors"><%= p %></a>
                    <% } else if (p === 2 || p === pagination.totalPages - 1) { %>
                        <span class="px-1 text-slate-400">...</span>
                    <% } %>
                <% } %>

                <% if (pagination.hasNextPage) { %>
                    <a href="<%= buildQueryString(queryState, { page: pagination.nextPage }) %>" class="px-3 py-1.5 border border-slate-200 rounded-lg hover:bg-slate-100 text-slate-700 font-semibold transition-colors flex items-center gap-1">
                        Next &rarr;
                    </a>
                <% } else { %>
                    <span class="px-3 py-1.5 border border-slate-100 rounded-lg text-slate-300 font-semibold cursor-not-allowed">Next &rarr;</span>
                <% } %>
            </div>
        </div>
    <% } %>

    <% } %>

    <!-- POST NEW MODAL -->
    <div id="postingModal"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-xl max-w-lg w-full p-6 shadow-xl relative">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Post New Internship Listing</h3>
                    <p class="text-xs text-slate-500">Add an opportunity to match eligible candidates under PMIS.</p>
                </div>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <i class="ph-bold ph-x text-xl"></i>
                </button>
            </div>

            <form action="/internships/new" method="POST" class="mt-4 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Internship Role Title</label>
                    <input type="text" name="title" required placeholder="e.g. Quality Control Assistant"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Organization</label>
                        <input type="text" name="company" required placeholder="e.g. Tata Motors"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Industry Sector</label>
                        <input type="text" name="sector" required placeholder="e.g. Automotive"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Location (District,
                            State)</label>
                        <input type="text" name="location" required placeholder="e.g. Pune, Maharashtra"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Total Open Vacancies</label>
                        <input type="number" name="vacancies" min="1" value="5" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Stipend (₹)</label>
                        <input type="number" name="stipend" required placeholder="e.g. 10000" min="0" step="500"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Duration</label>
                        <input type="text" name="duration" placeholder="e.g. 12 Months"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Required Skills (Comma
                        Separated)</label>
                    <input type="text" name="requiredSkills" required placeholder="e.g. Quality Control, Python"
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
                    <button type="button" onclick="closeModal()"
                        class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200">Cancel</button>
                    <button type="submit"
                        class="px-4 py-2 text-xs font-semibold text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg shadow-sm">Publish
                        Listing</button>
                </div>
            </form>
        </div>
    </div>


    <div id="editModal"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-xl max-w-lg w-full p-6 shadow-xl relative">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Edit Internship Listing</h3>
                    <p class="text-xs text-slate-500">Update listing details for PMIS candidates.</p>
                </div>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <i class="ph-bold ph-x text-xl"></i>
                </button>
            </div>

            <form id="editForm" method="POST" class="mt-4 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Internship Role Title</label>
                    <input type="text" id="edit_title" name="title" required
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Company / Organization</label>
                        <input type="text" id="edit_company" name="company" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Industry Sector</label>
                        <input type="text" id="edit_sector" name="sector" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Location (District,
                            State)</label>
                        <input type="text" id="edit_location" name="location" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Total Open Vacancies</label>
                        <input type="number" id="edit_vacancies" name="vacancies" min="1" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Stipend (₹)</label>
                        <input type="number" id="edit_stipend" name="stipend" required
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Duration</label>
                        <input type="text" id="edit_duration" name="duration"
                            class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Required Skills (Comma
                        Separated)</label>
                    <input type="text" id="edit_skills" name="requiredSkills" required
                        class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600">
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
                    <button type="button" onclick="closeEditModal()"
                        class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200">Cancel</button>
                    <button type="submit"
                        class="px-4 py-2 text-xs font-semibold text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg shadow-sm">Save
                        Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal() {
            document.getElementById('postingModal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('postingModal').classList.add('hidden');
        }

        function openEditModal(button) {
            try {
                const item = JSON.parse(button.getAttribute('data-item'));
                document.getElementById('editForm').action = '/internships/' + item._id + '/edit';
                document.getElementById('edit_title').value = item.title || '';
                document.getElementById('edit_company').value = item.companyName || item.company || '';
                document.getElementById('edit_sector').value = item.sector || '';

                let locStr = '';
                if (typeof item.location === 'object' && item.location !== null) {
                    locStr = (item.location.district || '') + (item.location.state ? ', ' + item.location.state : '');
                } else {
                    locStr = item.location || '';
                }
                document.getElementById('edit_location').value = locStr;

                document.getElementById('edit_vacancies').value = item.vacancies || 1;
                document.getElementById('edit_stipend').value = item.monthlyStipend || 5000;
                document.getElementById('edit_duration').value = item.duration || '12 Months';
                document.getElementById('edit_skills').value = Array.isArray(item.requiredSkills) ? item.requiredSkills.join(', ') : '';

                document.getElementById('editModal').classList.remove('hidden');
            } catch (err) {
                console.error('Error parsing item data:', err);
            }
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }
    </script>