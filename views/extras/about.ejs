<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-8">

    <!-- Top Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-indigo-600 transition-colors">Home</a>
        <i class="ph ph-caret-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold">About InternPilot</span>
    </nav>

    <!-- Hero Card -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm relative overflow-hidden">
        <div class="max-w-3xl space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-full text-xs font-semibold">
                <i class="ph-bold ph-sparkle text-indigo-600"></i>
                <span>Prime Minister's Internship Scheme Digital Partner</span>
            </div>

            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
                Empowering India's Youth Through <span class="text-indigo-600">Smart Internship Matching</span>
            </h1>

            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                InternPilot is the dedicated technological backbone supporting the Prime Minister's Internship Scheme (PMIS), under the Ministry of Corporate Affairs, Government of India. Our portal bridges ambitious youth aged 21–24 with premier companies across India using intelligent AI-assisted skill recommendations.
            </p>
        </div>
    </div>

    <!-- Core Objectives Grid -->
    <div class="space-y-4">
        <div class="space-y-1">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">Our Core Mission & Objectives</h2>
            <p class="text-xs text-slate-500">How InternPilot accelerates India's demographic dividend</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Pillar 1 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 text-xl font-bold">
                    <i class="ph-bold ph-graduation-cap"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900">Empowering 1 Crore Youth</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Designed to facilitate practical on-the-job training in top 500 companies across India over a five-year horizon, elevating youth employability.
                </p>
            </div>

            <!-- Pillar 2 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 text-xl font-bold">
                    <i class="ph-bold ph-cpu"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900">AI-Powered Skill Match</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Neural match algorithms assess student academic credentials and technical proficiencies against live vacancy requirements, providing objective suitability scores.
                </p>
            </div>

            <!-- Pillar 3 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
                <div class="w-10 h-10 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center text-purple-600 text-xl font-bold">
                    <i class="ph-bold ph-shield-check"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900">Transparent & Secure</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                    Complete corporate verification via MCA Corporate Identification Numbers (CIN) ensures zero fraudulent postings and guaranteed candidate protections.
                </p>
            </div>
        </div>
    </div>

    <!-- Stakeholder Value -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 text-xl font-bold">
                    <i class="ph-bold ph-users-four"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">For Candidates</h3>
                    <p class="text-xs text-slate-500">Fast-track your corporate career</p>
                </div>
            </div>
            <ul class="space-y-2 text-xs text-slate-600">
                <li class="flex items-start gap-2">
                    <i class="ph-bold ph-check text-emerald-600 text-sm mt-0.5"></i>
                    <span>Apply to accredited PMIS 12-month internship listings nationwide.</span>
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph-bold ph-check text-emerald-600 text-sm mt-0.5"></i>
                    <span>Receive ₹5,000 monthly stipend + ₹6,000 one-time incident grant directly via DBT.</span>
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph-bold ph-check text-emerald-600 text-sm mt-0.5"></i>
                    <span>Track real-time application status updates with email notifications.</span>
                </li>
            </ul>
            <div class="pt-2">
                <a href="/internships" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
                    Explore Opportunities <i class="ph-bold ph-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600 text-xl font-bold">
                    <i class="ph-bold ph-buildings"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">For Partner Enterprises</h3>
                    <p class="text-xs text-slate-500">Harness certified emerging talent</p>
                </div>
            </div>
            <ul class="space-y-2 text-xs text-slate-600">
                <li class="flex items-start gap-2">
                    <i class="ph-bold ph-check text-emerald-600 text-sm mt-0.5"></i>
                    <span>Publish internship listings with custom role qualifications and vacancy metrics.</span>
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph-bold ph-check text-emerald-600 text-sm mt-0.5"></i>
                    <span>Pre-ranked candidate suitability dashboards minimizing recruitment overhead.</span>
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph-bold ph-check text-emerald-600 text-sm mt-0.5"></i>
                    <span>Collaborative team management with recruiter delegation and activity logging.</span>
                </li>
            </ul>
            <div class="pt-2">
                <a href="/auth/register" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
                    Register as Company <i class="ph-bold ph-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

</div>
