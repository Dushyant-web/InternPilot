<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-8">

    <!-- Top Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-indigo-600 transition-colors">Home</a>
        <i class="ph ph-caret-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold">Contact & Helpdesk</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm relative overflow-hidden">
        <div class="max-w-3xl space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-full text-xs font-semibold">
                <i class="ph-bold ph-headset text-indigo-600"></i>
                <span>PMIS National Support Helpdesk</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                Get in Touch with InternPilot Support
            </h1>

            <p class="text-sm text-slate-600 leading-relaxed">
                Have questions regarding the Prime Minister's Internship Scheme, candidate eligibility, company onboarding, or technical assistance? Our dedicated support team is here to assist.
            </p>
        </div>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Toll Free Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 text-xl font-bold">
                <i class="ph-bold ph-phone-call"></i>
            </div>
            <h3 class="text-base font-bold text-slate-900">National Helpline</h3>
            <p class="text-xs text-slate-500">Toll-free telephonic support</p>
            <div class="pt-2 text-xs font-semibold text-slate-800 space-y-1">
                <p class="text-lg font-bold text-indigo-600">1800-180-1111</p>
                <p class="text-[11px] text-slate-500">Mon - Sat: 9:00 AM - 6:00 PM IST</p>
            </div>
        </div>

        <!-- Email Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 text-xl font-bold">
                <i class="ph-bold ph-envelope"></i>
            </div>
            <h3 class="text-base font-bold text-slate-900">Email Support</h3>
            <p class="text-xs text-slate-500">Direct inquiries & technical queries</p>
            <div class="pt-2 text-xs font-semibold text-slate-800 space-y-1">
                <a href="mailto:support-pmis@gov.in" class="text-sm font-bold text-emerald-600 hover:underline block">
                    support-pmis@gov.in
                </a>
                <a href="mailto:helpdesk@internpilot.in" class="text-xs text-slate-600 hover:underline block">
                    helpdesk@internpilot.in
                </a>
            </div>
        </div>

        <!-- Office Address Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center text-purple-600 text-xl font-bold">
                <i class="ph-bold ph-map-pin"></i>
            </div>
            <h3 class="text-base font-bold text-slate-900">PMIS Cell Headquarters</h3>
            <p class="text-xs text-slate-500">Ministry of Corporate Affairs</p>
            <div class="pt-2 text-xs text-slate-600 space-y-0.5 leading-relaxed">
                <p class="font-medium text-slate-800">Shastri Bhawan, Dr. Rajendra Prasad Road</p>
                <p>New Delhi, Delhi - 110001, India</p>
            </div>
        </div>

    </div>

    <!-- Category Inquiries & Redressal Notice -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
        <div>
            <h2 class="text-lg font-bold text-slate-900">Direct Departmental Escalation</h2>
            <p class="text-xs text-slate-500 mt-1">Select the relevant channel for your specific query</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-2">
                <span class="font-bold text-slate-800 flex items-center gap-1.5 text-sm">
                    <i class="ph-bold ph-user text-indigo-600"></i> Candidate Assistance
                </span>
                <p class="text-slate-600 leading-relaxed">
                    For questions regarding registration status, OTP delivery, resume upload, or application tracking, write to us with your registered email and Candidate ID.
                </p>
            </div>

            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-2">
                <span class="font-bold text-slate-800 flex items-center gap-1.5 text-sm">
                    <i class="ph-bold ph-buildings text-indigo-600"></i> Corporate Helpdesk
                </span>
                <p class="text-slate-600 leading-relaxed">
                    For corporate CIN verification, posting new internship listings, recruiter team management, or vacancy updates, reach out to corporate.pmis@gov.in.
                </p>
            </div>
        </div>

        <div class="p-4 bg-amber-50/70 border border-amber-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-0.5">
                <span class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                    <i class="ph-bold ph-warning-circle text-amber-600"></i> Unresolved dispute or complaint?
                </span>
                <p class="text-xs text-amber-700">
                    If your issue remains unresolved, please submit a formal grievance for time-bound resolution.
                </p>
            </div>
            <a href="/grievance" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors whitespace-nowrap">
                Grievance Redressal
            </a>
        </div>
    </div>

</div>
