<% layout('layouts/boilerplate') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-12 mt-16">
    <!-- Header Section -->
    <div class="mb-8">
        <a href="/internships" class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 hover:text-indigo-700 mb-4 transition-colors">
            <i class="ph-bold ph-arrow-left"></i> Back to Opportunities
        </a>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Compare Internships</h1>
        <p class="text-slate-500 text-sm mt-1">Evaluating side-by-side to find the perfect fit.</p>
    </div>

    <% if (!internships || internships.length === 0) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
            <i class="ph-bold ph-warning-circle text-4xl text-amber-500 mb-2"></i>
            <h3 class="text-base font-bold text-slate-800">No Internships Selected</h3>
            <p class="text-xs text-slate-500 mt-1 mb-4">Please go back and select 2 to 3 internships to compare.</p>
            <a href="/internships" class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors">
                Browse Opportunities
            </a>
        </div>
    <% } else { %>
        <!-- Comparison Table -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[800px]">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="w-48 p-4 font-semibold text-slate-700 text-sm border-r border-slate-200">Feature</th>
                        <% internships.forEach(item => { %>
                            <th class="p-4 align-top w-1/3 border-r border-slate-200 last:border-0">
                                <h3 class="font-bold text-slate-900 text-base mb-1 line-clamp-2"><%= item.title %></h3>
                                <div class="text-sm text-indigo-600 font-medium">
                                    <%= item.companyName || 'Unknown Company' %>
                                </div>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody class="text-sm divide-y divide-slate-100">
                    <!-- Location Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Location</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600">
                                <div class="flex items-start gap-1.5">
                                    <i class="ph-fill ph-map-pin text-slate-400 mt-0.5"></i>
                                    <span>
                                        <% if (item.location && (item.location.district || item.location.state)) { %>
                                            <%= [item.location.district, item.location.state].filter(Boolean).join(', ') %>
                                        <% } else { %>
                                            Not specified
                                        <% } %>
                                    </span>
                                </div>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Stipend Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Stipend</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600">
                                <div class="flex flex-col gap-1">
                                    <span class="font-medium text-emerald-700">
                                        <% if (item.monthlyStipend === 0 || item.monthlyStipend === 'Unpaid') { %>
                                            Unpaid
                                        <% } else if (item.monthlyStipend === 'Performance Based') { %>
                                            Performance Based
                                        <% } else { %>
                                            ₹<%= item.monthlyStipend ? item.monthlyStipend.toLocaleString() : 'Not specified' %> / month
                                        <% } %>
                                    </span>
                                </div>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Duration Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Duration</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600">
                                <div class="flex items-center gap-1.5">
                                    <i class="ph-bold ph-clock text-slate-400"></i>
                                    <%= item.duration ? item.duration : 'Not specified' %>
                                </div>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Sector / Category Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Sector</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                                    <%= item.sector || 'General' %>
                                </span>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Minimum Qualifications Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Minimum Qualifications</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600 align-top">
                                <% if (item.minQualifications || item.minQualification) { %>
                                    <div class="text-sm text-slate-600 whitespace-pre-wrap"><%= item.minQualifications || item.minQualification %></div>
                                <% } else { %>
                                    <span class="text-slate-400 italic">Not specified</span>
                                <% } %>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Required Skills Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Required Skills</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600 align-top">
                                <% if (item.requiredSkills && item.requiredSkills.length > 0) { %>
                                    <div class="flex flex-wrap gap-1.5 mt-1">
                                        <% item.requiredSkills.forEach(skill => { %>
                                            <% if (skill.trim()) { %>
                                                <span class="text-[10px] font-medium text-slate-600 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">
                                                    <%= skill.trim() %>
                                                </span>
                                            <% } %>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-400 italic">No specific skills listed</span>
                                <% } %>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Application Deadline Row -->
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="p-4 font-semibold text-slate-700 border-r border-slate-200 bg-slate-50/30">Deadline</td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-slate-600">
                                <% if (item.applicationDeadline) { %>
                                    <% 
                                        const deadlineDate = new Date(item.applicationDeadline);
                                        const now = new Date();
                                        const daysLeft = Math.ceil((deadlineDate - now) / (1000 * 60 * 60 * 24));
                                    %>
                                    <div class="flex items-center gap-1.5 <%= daysLeft < 3 ? 'text-red-600 font-medium' : '' %>">
                                        <i class="ph-bold ph-calendar-blank"></i>
                                        <%= deadlineDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-400 italic">Not specified</span>
                                <% } %>
                            </td>
                        <% }) %>
                    </tr>

                    <!-- Action Row -->
                    <tr class="bg-slate-50/50">
                        <td class="p-4 border-r border-slate-200"></td>
                        <% internships.forEach(item => { %>
                            <td class="p-4 border-r border-slate-200 last:border-0 text-center">
                                <a href="/internships/<%= item._id %>" class="inline-block w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm transition-colors text-center">
                                    View Details & Apply
                                </a>
                            </td>
                        <% }) %>
                    </tr>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
