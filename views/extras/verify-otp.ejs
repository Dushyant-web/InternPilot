<% layout('layouts/boilerplate') %>

    <div class="max-w-md mx-auto px-4 py-16">
        <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm space-y-6 text-center">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-indigo-50 text-indigo-600 rounded-full mb-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                    </path>
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-slate-900">Verify Your Email</h1>
            <p class="text-sm text-slate-600">
                We've sent a 6-digit verification code to <span class="font-semibold text-slate-900">
                    <%= email %>
                </span>. Enter it below to activate your account.
            </p>

            <form action="/auth/verify-otp" method="POST" class="space-y-4 text-left">
                <input type="hidden" name="email" value="<%= email %>">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Enter OTP Code</label>
                    <input type="text" name="otp" required maxlength="6"
                        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:outline-none text-center font-mono text-lg tracking-widest"
                        placeholder="123456">
                </div>

                <button type="submit"
                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors shadow-sm text-sm">
                    Verify Account
                </button>
            </form>
        </div>
    </div>