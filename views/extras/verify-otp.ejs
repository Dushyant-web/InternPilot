<% layout('layouts/boilerplate') %>

    <div class="max-w-md mx-auto px-4 py-16">
        <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm space-y-6 text-center">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-indigo-50 text-indigo-600 rounded-full mb-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                    </path>
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-slate-900">Verify Your Email</h1>
            <p class="text-sm text-slate-600">
                We've sent a 6-digit verification code to <span class="font-semibold text-slate-900">
                    <%= email %>
                </span>. Enter it below to activate your account.
            </p>

            <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-2.5 rounded-lg text-xs font-medium flex items-center justify-center gap-2 text-left">
                    <svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span><%= success_msg %></span>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-2.5 rounded-lg text-xs font-medium flex items-center justify-center gap-2 text-left">
                    <svg class="w-4 h-4 shrink-0 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span><%= error_msg %></span>
                </div>
            <% } %>

            <form action="/auth/verify-otp" method="POST" class="space-y-4 text-left">
                <input type="hidden" name="email" value="<%= email %>">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Enter OTP Code</label>
                    <input type="text" name="otp" id="otpInput" required maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus
                        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:outline-none text-center font-mono text-xl tracking-widest"
                        placeholder="123456">
                </div>

                <button type="submit"
                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors shadow-sm text-sm">
                    Verify Account
                </button>
            </form>

            <div class="pt-4 border-t border-slate-100 flex flex-col items-center justify-center space-y-3">
                <p class="text-sm text-slate-600">Didn't receive the email?</p>
                <form id="resendForm" action="/auth/resend-otp" method="POST">
                    <input type="hidden" name="email" value="<%= email %>">
                    <button type="submit" id="resendBtn" disabled
                        class="inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-800 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <span>Resend OTP</span>
                        <span id="cooldownTimer" class="ml-1 text-xs font-mono text-slate-500">(60s)</span>
                    </button>
                </form>
                <div>
                    <a href="/auth/register" class="text-xs text-slate-400 hover:text-slate-600 transition-colors">
                        Wrong email address? Register again
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const email = '<%= email %>';
            const resendBtn = document.getElementById('resendBtn');
            const cooldownSpan = document.getElementById('cooldownTimer');
            const resendForm = document.getElementById('resendForm');
            const otpInput = document.getElementById('otpInput');
            const storageKey = 'otp_cooldown_' + encodeURIComponent(email);
            const COOLDOWN_DURATION = 60 * 1000; // 60 seconds

            // Only allow numbers in OTP input
            if (otpInput) {
                otpInput.addEventListener('input', function (e) {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }

            let cooldownEnd;
            try {
                cooldownEnd = parseInt(sessionStorage.getItem(storageKey), 10);
            } catch (_) {
                cooldownEnd = NaN;
            }

            const now = Date.now();

            // Initialize cooldown if not set or invalid
            if (!cooldownEnd || isNaN(cooldownEnd)) {
                cooldownEnd = now + COOLDOWN_DURATION;
                try {
                    sessionStorage.setItem(storageKey, cooldownEnd);
                } catch (_) {
                    // Fallback to in-memory cooldown
                }
            }

            function updateCooldown() {
                const current = Date.now();
                const remainingMs = cooldownEnd - current;

                if (remainingMs > 0) {
                    const seconds = Math.ceil(remainingMs / 1000);
                    resendBtn.disabled = true;
                    cooldownSpan.textContent = '(' + seconds + 's)';
                } else {
                    resendBtn.disabled = false;
                    cooldownSpan.textContent = '';
                }
            }

            updateCooldown();
            const interval = setInterval(function () {
                updateCooldown();
                if (Date.now() >= cooldownEnd) {
                    clearInterval(interval);
                }
            }, 1000);

            if (resendForm) {
                resendForm.addEventListener('submit', function () {
                    // Set new cooldown for next request
                    cooldownEnd = Date.now() + COOLDOWN_DURATION;
                    try {
                        sessionStorage.setItem(storageKey, cooldownEnd);
                    } catch (_) {
                        // Fallback to in-memory cooldown
                    }
                    resendBtn.disabled = true;
                    cooldownSpan.textContent = '(60s)';
                });
            }
        })();
    </script>