<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-8">

    <!-- Top Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-indigo-600 transition-colors">Home</a>
        <i class="ph ph-caret-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold">PMIS Guidelines</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm relative overflow-hidden">
        <div class="max-w-3xl space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 text-amber-800 rounded-full text-xs font-semibold">
                <i class="ph-bold ph-book-open text-amber-600"></i>
                <span>Ministry of Corporate Affairs, Government of India</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                Prime Minister's Internship Scheme Guidelines
            </h1>

            <p class="text-sm text-slate-600 leading-relaxed">
                Official rules, eligibility criteria, and financial provisions governing candidate participation and partner corporate obligations under the PM Internship Scheme (PMIS).
            </p>
        </div>
    </div>

    <!-- Candidate Eligibility & Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Eligibility Criteria -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 text-xl font-bold">
                    <i class="ph-bold ph-identification-card"></i>
                </div>
                <div>
                    <h2 class="text-base font-bold text-slate-900">Candidate Eligibility Criteria</h2>
                    <p class="text-xs text-slate-500">Prerequisites for registration</p>
                </div>
            </div>

            <ul class="space-y-3 text-xs text-slate-600">
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-check-circle text-indigo-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">Age Limit:</strong> Candidates must be between <strong>21 and 24 years</strong> of age as of the registration cutoff date.
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-check-circle text-indigo-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">Educational Background:</strong> High School (Class 10/12), ITI certificate, Polytechnic Diploma, or recognized Graduate Degree (BA, BSc, BCom, BCA, BBA, B.Tech, etc.).
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-check-circle text-indigo-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">Nationality:</strong> Must be a citizen of India with valid Aadhaar authentication.
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-x-circle text-rose-500 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">Ineligibility:</strong> Individuals currently enrolled in full-time formal education, full-time regular employment, or whose family member is a permanent government employee are not eligible.
                    </div>
                </li>
            </ul>
        </div>

        <!-- Financial Provisions -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 text-xl font-bold">
                    <i class="ph-bold ph-currency-inr"></i>
                </div>
                <div>
                    <h2 class="text-base font-bold text-slate-900">Financial Assistance & Stipend</h2>
                    <p class="text-xs text-slate-500">Government & CSR direct disbursements</p>
                </div>
            </div>

            <ul class="space-y-3 text-xs text-slate-600">
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-check-circle text-emerald-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">Monthly Stipend of ₹5,000:</strong>
                        <span>₹4,500 disbursed directly by the Central Government via Direct Benefit Transfer (DBT) and ₹500 contributed by the host company from its CSR fund.</span>
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-check-circle text-emerald-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">One-time Incident Grant of ₹6,000:</strong>
                        <span>Granted directly upon successful physical or operational joining at the host internship location.</span>
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <i class="ph-bold ph-check-circle text-emerald-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-800">Insurance Protection:</strong>
                        <span>Comprehensive accidental and life insurance under PMJJBY and PMSBY during the 12-month tenure.</span>
                    </div>
                </li>
            </ul>
        </div>

    </div>

    <!-- Company Standards -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="ph-bold ph-buildings text-indigo-600"></i> Obligations for Participating Companies
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-600">
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-1.5">
                <span class="font-bold text-slate-800 block">1. Verified Accreditation</span>
                <p>Employers must register with verified MCA CIN and designated corporate HR leadership credentials.</p>
            </div>
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-1.5">
                <span class="font-bold text-slate-800 block">2. Structured Mentorship</span>
                <p>Every intern must be assigned an industry mentor for progressive skill development throughout the 12-month term.</p>
            </div>
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 space-y-1.5">
                <span class="font-bold text-slate-800 block">3. Zero Candidate Fee</span>
                <p>Strictly zero fees, security deposits, or hidden processing charges may be levied upon any candidate at any point.</p>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Call to Action -->
    <div class="flex items-center justify-between p-6 bg-indigo-50 border border-indigo-100 rounded-2xl">
        <div class="space-y-0.5">
            <h3 class="text-sm font-bold text-indigo-900">Ready to explore eligible opportunities?</h3>
            <p class="text-xs text-indigo-700">Browse current open positions verified under PMIS regulations.</p>
        </div>
        <a href="/internships" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-colors">
            View Listings
        </a>
    </div>

</div>
