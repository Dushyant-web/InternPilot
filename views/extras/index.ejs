    <style>
        /* Continuous background glow shift for AI gradient text */
        @keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .animate-gradient-text {
            background-size: 200% auto;
            animation: gradientShift 5s ease infinite;
        }

        /* Ambient background glow behind hero */
        .hero-glow {
            position: absolute;
            top: -10%;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 800px;
            height: 400px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(168, 85, 247, 0.08) 50%, transparent 70%);
            filter: blur(60px);
            pointer-events: none;
            z-index: 0;
        }

        @keyframes drawLine {
            to {
                transform: scaleX(1);
            }
        }

        @keyframes drawLineVertical {
            to {
                transform: scaleY(1);
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .animate-\[drawLine_1\.2s_ease-out_0\.5s_forwards\],
            .animate-\[drawLineVertical_1\.2s_ease-out_0\.5s_forwards\] {
                animation: none;
                transform: scale(1);
            }
        }
    </style>

