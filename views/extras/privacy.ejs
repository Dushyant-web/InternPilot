<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-8">

    <!-- Top Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-indigo-600 transition-colors">Home</a>
        <i class="ph ph-caret-right text-[10px]"></i>
        <span class="text-slate-800 font-semibold">Privacy Policy</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm relative overflow-hidden">
        <div class="max-w-3xl space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-full text-xs font-semibold">
                <i class="ph-bold ph-lock-key text-indigo-600"></i>
                <span>Digital Personal Data Protection (DPDP) Act, 2023 Compliant</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                InternPilot Privacy Policy
            </h1>

            <p class="text-sm text-slate-600 leading-relaxed">
                Your privacy is paramount. This policy articulates how InternPilot collects, processes, and safeguards candidate and corporate data within the PM Internship Scheme ecosystem.
            </p>

            <p class="text-[11px] text-slate-400 font-medium">
                Last Updated: <%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
            </p>
        </div>
    </div>

    <!-- Policy Sections -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-8 text-xs text-slate-600 leading-relaxed">

        <!-- 1. Scope and Information Collected -->
        <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs">1</span>
                Information We Collect
            </h2>
            <p>
                To provide seamless matching under the Prime Minister's Internship Scheme, InternPilot collects information when you interact with our platform:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-slate-600">
                <li><strong class="text-slate-800">Candidate Data:</strong> Name, contact details (email address, mobile number), date of birth, educational background, technical/soft skills, preferred locations, and uploaded resume files (PDF/DOCX).</li>
                <li><strong class="text-slate-800">Employer Data:</strong> Corporate name, Corporate Identification Number (CIN), industry sector, authorized recruiter names, work email addresses, and contact phone numbers.</li>
                <li><strong class="text-slate-800">Audit & Log Data:</strong> Timestamped action events, login security sessions, application status transitions, and IP headers for cybersecurity verification.</li>
            </ul>
        </section>

        <!-- 2. AI Skill Matching & PII Protection -->
        <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs">2</span>
                AI Skill Analysis & Privacy Safeguards
            </h2>
            <p>
                InternPilot uses advanced machine learning for suitability analysis. Before any candidate profile is analyzed for internship suitability scoring, our platform applies an automated <strong class="text-slate-800">Privacy Filter</strong> that strips sensitive Personally Identifiable Information (such as exact residential addresses, Aadhaar numbers, or parentage details). Scoring is performed purely on normalized skills, academic qualification, and sector alignment.
            </p>
        </section>

        <!-- 3. Purpose of Processing -->
        <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs">3</span>
                Purpose and Use of Data
            </h2>
            <p>We process collected data exclusively for:</p>
            <ul class="list-disc pl-5 space-y-1.5">
                <li>Facilitating internship discovery and application submissions to accredited PMIS partner companies.</li>
                <li>Delivering transactional status communications (e.g. application submission, interview shortlisting, rejection notices) via automated email notifications.</li>
                <li>Verifying corporate credentials against MCA statutory databases to prevent unauthorized or illegitimate listings.</li>
                <li>Auditing application integrity and preventing duplicate or fraudulent submissions.</li>
            </ul>
        </section>

        <!-- 4. Zero Data Commercialization -->
        <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs">4</span>
                Zero Third-Party Commercial Sharing
            </h2>
            <p>
                We do not sell, rent, monetize, or disclose candidate or employer data to marketing agencies, brokers, or unrelated third parties. Data is shared exclusively with verified host employers when a candidate submits an internship application.
            </p>
        </section>

        <!-- 5. Data Security & Storage -->
        <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs">5</span>
                Data Security Standards
            </h2>
            <p>
                InternPilot employs industry-standard encryption protocols (TLS/HTTPS in transit, salted bcrypt password hashing, and encrypted database storage). Cloud resume assets are stored within access-controlled storage buckets with authenticated URLs.
            </p>
        </section>

        <!-- 6. Candidate Data Rights -->
        <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs">6</span>
                Your Data Protection Rights
            </h2>
            <p>
                In accordance with India's Digital Personal Data Protection Act (DPDP), candidates maintain full authority over their information, including the right to view profile details, correct inaccuracies, update resumes, or withdraw pending internship applications at any time from their personal dashboard.
            </p>
        </section>

    </div>

</div>
