<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-50 flex items-center justify-center min-h-screen">
    <div class="max-w-xl w-full mx-auto px-4 text-center">
        <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm space-y-6">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 text-red-600 rounded-full mb-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                    </path>
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-slate-900">An Error Occurred</h1>

            <p class="text-sm text-slate-600">
                <%= message || 'Something went wrong on our end. Please try again later.' %>
            </p>

            <% if (error && error.stack) { %>
                <div class="text-left bg-slate-50 p-4 rounded-lg border border-slate-200 overflow-x-auto">
                    <pre class="text-xs text-red-600 font-mono"><%= error.stack %></pre>
                </div>
                <% } %>

                    <div class="pt-4">
                        <a href="/"
                            class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors shadow-sm inline-block">
                            Back to Home
                        </a>
                    </div>
        </div>
    </div>
</body>

</html>