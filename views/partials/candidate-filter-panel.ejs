<%
    const f = typeof candidateFilters !== 'undefined' && candidateFilters ? candidateFilters : null;
    const opts = typeof filterOptions !== 'undefined' && filterOptions ? filterOptions : null;
    const base = typeof filterBasePath !== 'undefined' && filterBasePath ? filterBasePath : '';
%>
<% if (f && opts && base) { %>
<%
    const lowerSet = list => new Set((list || []).map(v => String(v).toLowerCase()));
    const dropdowns = [
        { name: 'skills', label: 'Skills', icon: 'ph-code', options: opts.skills, chosen: lowerSet(f.skills), searchable: true, hint: 'Candidate must have every skill ticked' },
        { name: 'qualification', label: 'Qualification', icon: 'ph-graduation-cap', options: opts.qualification, chosen: lowerSet(f.qualification) },
        { name: 'location', label: 'Location', icon: 'ph-map-pin', options: opts.location, chosen: lowerSet(f.location), searchable: opts.location.length > 6 }
    ];
    const levels = typeof experienceLevels !== 'undefined' && Array.isArray(experienceLevels) ? experienceLevels : [];
%>
<%# data-no-loading: results load in place, so the global submit spinner would never clear. %>
<form action="<%= base %>" method="GET" data-candidate-filters data-no-loading
    class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm space-y-3">

    <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
            <i class="ph-bold ph-funnel text-indigo-600" aria-hidden="true"></i> Filter Candidates
        </h3>
        <button type="submit" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors">
            Apply
        </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <% dropdowns.forEach(dd => { %>
            <details class="group relative" data-filter-dropdown>
                <summary class="list-none w-full flex items-center justify-between px-3 py-2 text-xs border border-slate-200 rounded-lg bg-slate-50 hover:bg-white cursor-pointer select-none">
                    <span class="flex items-center gap-2 text-slate-700 min-w-0">
                        <i class="ph-bold <%= dd.icon %> text-slate-400 text-sm shrink-0" aria-hidden="true"></i>
                        <span class="truncate" data-dropdown-summary data-label="<%= dd.label %>">
                            <%= dd.chosen.size ? `${dd.label} (${dd.chosen.size})` : `${dd.label}: any` %>
                        </span>
                    </span>
                    <i class="ph-bold ph-caret-down text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"></i>
                </summary>

                <div class="absolute z-30 mt-1 w-full min-w-56 bg-white border border-slate-200 rounded-lg shadow-lg p-2">
                    <% if (dd.hint) { %><p class="text-[11px] text-slate-400 px-1.5 pb-1.5"><%= dd.hint %></p><% } %>
                    <% if (dd.options.length) { %>
                        <% if (dd.searchable) { %>
                            <input type="search" placeholder="Find..." data-option-search aria-label="Find <%= dd.label.toLowerCase() %>"
                                class="w-full px-2.5 py-1.5 mb-2 text-xs border border-slate-200 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-600">
                        <% } %>
                        <div class="max-h-48 overflow-y-auto space-y-0.5 pr-1" role="group" aria-label="<%= dd.label %>">
                            <% dd.options.forEach(opt => { %>
                                <label class="flex items-center gap-2 px-1.5 py-1 rounded hover:bg-slate-50 text-xs text-slate-700 cursor-pointer" data-option="<%= opt.value.toLowerCase() %>">
                                    <input type="checkbox" name="<%= dd.name %>" value="<%= opt.value %>"
                                        <%= dd.chosen.has(opt.value.toLowerCase()) ? 'checked' : '' %>
                                        class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                    <span class="truncate flex-1"><%= opt.value %></span>
                                    <span class="text-[10px] font-semibold text-slate-400 tabular-nums"><%= opt.count %></span>
                                </label>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-[11px] text-slate-400 italic px-1.5 py-1">No applicant has this on their profile yet.</p>
                    <% } %>
                </div>
            </details>
        <% }) %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-center">
        <div>
            <label for="experienceFilter" class="sr-only">Experience</label>
            <select id="experienceFilter" name="experience"
                class="w-full px-3 py-2 text-xs border border-slate-200 rounded-lg bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-600 cursor-pointer">
                <option value="">Experience: any</option>
                <% levels.forEach(level => { %>
                    <option value="<%= level.key %>" <%= f.experience === level.key ? 'selected' : '' %>><%= level.label %></option>
                <% }) %>
            </select>
        </div>

        <div class="flex items-center gap-3 px-1">
            <label for="minMatchFilter" class="text-xs font-semibold text-slate-600 whitespace-nowrap">AI match</label>
            <input type="range" id="minMatchFilter" name="minMatch" min="0" max="100" step="5" value="<%= f.minMatch %>"
                aria-describedby="minMatchValue" class="flex-1 accent-indigo-600 cursor-pointer">
            <output id="minMatchValue" for="minMatchFilter" data-match-output
                class="text-xs font-bold text-indigo-700 tabular-nums w-12 text-right"><%= f.minMatch ? f.minMatch + '%+' : 'Any' %></output>
        </div>

        <fieldset class="flex flex-wrap items-center gap-1.5">
            <legend class="sr-only">Application status</legend>
            <% if (opts.status.length) { %>
                <% opts.status.forEach(s => { %>
                    <label class="cursor-pointer">
                        <input type="checkbox" name="status" value="<%= s.value %>" class="peer sr-only" <%= f.status.includes(s.value) ? 'checked' : '' %>>
                        <span class="inline-flex items-center gap-1 px-2 py-1 text-[11px] font-semibold rounded-lg border border-slate-200 bg-slate-50 text-slate-600 transition-colors peer-checked:bg-indigo-600 peer-checked:border-indigo-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-600">
                            <%= s.value %> <span class="opacity-70 tabular-nums"><%= s.count %></span>
                        </span>
                    </label>
                <% }) %>
            <% } %>
        </fieldset>
    </div>
</form>
<% } %>
