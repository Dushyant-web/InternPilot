<% layout('layouts/boilerplate') %>

<div class="max-w-6xl mx-auto py-8 px-4 flex flex-col md:flex-row gap-6 h-[85vh]">
    <!-- Video / Status Panel -->
    <div class="w-full md:w-1/3 flex flex-col gap-4">
        <div class="bg-black rounded-lg aspect-video relative overflow-hidden flex items-center justify-center">
            <video id="userVideo" autoplay muted class="w-full h-full object-cover hidden"></video>
            <div id="videoPlaceholder" class="text-white text-center flex flex-col items-center">
                <i class="ph-bold ph-video-camera text-5xl mb-2 text-slate-500"></i>
                <p class="text-sm font-medium text-slate-400">Camera Off</p>
            </div>
            <button onclick="toggleVideo()" class="absolute bottom-4 right-4 bg-indigo-600 text-white p-3 rounded-full shadow-lg hover:bg-indigo-700 transition-transform hover:scale-105 z-10">
                <i class="ph-bold ph-video-camera text-lg"></i>
            </button>
        </div>
        
        <div class="bg-white p-4 rounded-lg shadow">
            <div class="flex justify-between items-center mb-2">
                <h3 class="font-bold text-gray-700">Session Info</h3>
                <button id="ttsToggle" onclick="toggleTTS()" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1" title="Toggle AI Voice">
                    <i class="ph-bold ph-speaker-high" id="ttsIcon"></i> Voice
                </button>
            </div>
            <p class="text-sm"><strong>Role:</strong> <%= session.role %></p>
            <p class="text-sm"><strong>Type:</strong> <%= session.interviewType %></p>
            <p class="text-sm"><strong>Mode:</strong> <%= session.mode %></p>
            <div class="mt-4 flex justify-between text-sm text-gray-600">
                <span id="turnCounter">Turn: <%= session.usage.turns %>/10</span>
            </div>
            <button onclick="completeInterview()" class="mt-4 w-full bg-red-600 text-white py-2 rounded hover:bg-red-700">End Interview Now</button>
        </div>
    </div>

    <!-- Chat / Transcript Panel -->
    <div class="w-full md:w-2/3 flex flex-col bg-white rounded-lg shadow overflow-hidden">
        <div id="transcriptArea" class="flex-1 p-4 overflow-y-auto bg-gray-50 flex flex-col gap-4">
            <% if (session.transcript.length === 0) { %>
                <div class="text-center text-gray-500 mt-10" id="welcomeMsg">
                    The AI is preparing your first question...
                </div>
            <% } else { %>
                <% session.transcript.forEach((t, i) => { %>
                    <!-- Question -->
                    <div class="flex gap-3">
                        <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold flex-shrink-0">AI</div>
                        <div class="bg-blue-100 p-3 rounded-lg rounded-tl-none max-w-[85%] text-gray-800">
                            <%= t.question %>
                        </div>
                    </div>
                    <!-- Answer -->
                    <% if (t.candidateAnswer) { %>
                        <div class="flex gap-3 flex-row-reverse">
                            <div class="w-8 h-8 rounded-full bg-green-600 flex items-center justify-center text-white font-bold flex-shrink-0">You</div>
                            <div class="bg-green-100 p-3 rounded-lg rounded-tr-none max-w-[85%] text-gray-800">
                                <%= t.candidateAnswer %>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            <% } %>
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-white border-t flex flex-col gap-2 relative">
            <div id="typingIndicator" class="hidden absolute -top-8 left-4 text-sm text-gray-500 italic">AI is thinking...</div>
            
            <div class="flex gap-4 mb-2">
                <button onclick="requestHint()" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1"><i class="ph-bold ph-lightbulb"></i> Hint</button>
                <button onclick="requestReframe()" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1"><i class="ph-bold ph-arrows-clockwise"></i> Reframe</button>
            </div>
            
            <div class="flex gap-3 items-center">
                <button id="micBtn" onclick="toggleMic()" class="shrink-0 flex items-center justify-center h-12 w-12 bg-slate-100 text-slate-600 rounded-xl hover:bg-slate-200 hover:text-indigo-600 transition-colors" title="Toggle microphone">
                    <i class="ph-bold ph-microphone text-xl" id="micIcon"></i>
                </button>
                <textarea id="answerInput" rows="2" class="flex-1 border border-slate-300 rounded-xl p-3 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 resize-none shadow-sm" placeholder="Type your answer or use the microphone..."></textarea>
                <button onclick="submitAnswer()" id="submitBtn" class="shrink-0 bg-indigo-600 text-white font-medium px-6 py-3 rounded-xl hover:bg-indigo-700 transition-colors shadow-sm h-12 flex items-center justify-center">Submit</button>
            </div>
        </div>
    </div>
</div>

<script>
let ttsEnabled = false;

function toggleTTS() {
    ttsEnabled = !ttsEnabled;
    const icon = document.getElementById('ttsIcon');
    if (ttsEnabled) {
        icon.classList.replace('ph-speaker-high', 'ph-speaker-slash');
        document.getElementById('ttsToggle').classList.replace('text-indigo-600', 'text-slate-500');
    } else {
        icon.classList.replace('ph-speaker-slash', 'ph-speaker-high');
        document.getElementById('ttsToggle').classList.replace('text-slate-500', 'text-indigo-600');
        speechSynthesis.cancel();
    }
}

function speakText(text) {
    if (!ttsEnabled || !('speechSynthesis' in window)) return;
    speechSynthesis.cancel(); // Stop current speech
    const utterance = new SpeechSynthesisUtterance(text.replace(/<[^>]*>?/gm, ''));
    
    // Try to find a good English voice
    const voices = speechSynthesis.getVoices();
    const goodVoice = voices.find(v => v.lang.includes('en-') && (v.name.includes('Google') || v.name.includes('Premium') || v.name.includes('Natural')));
    if (goodVoice) utterance.voice = goodVoice;
    
    utterance.rate = 1.05;
    speechSynthesis.speak(utterance);
}

// Make sure voices load properly in Chrome
if ('speechSynthesis' in window) {
    speechSynthesis.onvoiceschanged = () => speechSynthesis.getVoices();
}

let startTime = Date.now();
const sessionId = '<%= session._id %>';
let isInitial = <%= session.transcript.length === 0 %>;
const isTimed = '<%= session.mode %>' === 'Timed';
let turnTimer;
const TIME_PER_TURN = 120; // 2 minutes per question

function startTimer() {
    if (!isTimed) return;
    let timeLeft = TIME_PER_TURN;
    const timerDisplay = document.getElementById('timerDisplay') || createTimerDisplay();
    
    clearInterval(turnTimer);
    updateTimerUI(timeLeft, timerDisplay);
    
    turnTimer = setInterval(() => {
        timeLeft--;
        updateTimerUI(timeLeft, timerDisplay);
        if (timeLeft <= 0) {
            clearInterval(turnTimer);
            submitAnswer(true); // Force submit
        }
    }, 1000);
}

function createTimerDisplay() {
    const display = document.createElement('span');
    display.id = 'timerDisplay';
    display.className = 'font-mono font-bold ml-4 text-blue-600';
    document.getElementById('turnCounter').parentNode.appendChild(display);
    return display;
}

function updateTimerUI(seconds, element) {
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    element.innerText = `⏳ ${m}:${s < 10 ? '0' : ''}${s}`;
    if (seconds <= 30) element.classList.replace('text-blue-600', 'text-red-600');
    else element.classList.replace('text-red-600', 'text-blue-600');
}

// Video logic
async function toggleVideo() {
    const video = document.getElementById('userVideo');
    const placeholder = document.getElementById('videoPlaceholder');
    if (video.srcObject) {
        video.srcObject.getTracks().forEach(t => t.stop());
        video.srcObject = null;
        video.classList.add('hidden');
        placeholder.classList.remove('hidden');
    } else {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            video.srcObject = stream;
            video.classList.remove('hidden');
            placeholder.classList.add('hidden');
        } catch (e) {
            alert('Camera access denied or not available.');
        }
    }
}

// Speech to text logic
let recognition = null;
if ('webkitSpeechRecognition' in window) {
    recognition = new webkitSpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    
    recognition.onresult = function(event) {
        let finalTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
                finalTranscript += event.results[i][0].transcript;
            }
        }
        if (finalTranscript) {
            document.getElementById('answerInput').value += finalTranscript + ' ';
        }
    };
}

let isRecording = false;
function toggleMic() {
    if (!recognition) return alert('Speech recognition not supported in this browser.');
    const icon = document.getElementById('micIcon');
    const btn = document.getElementById('micBtn');
    
    if (isRecording) {
        recognition.stop();
        isRecording = false;
        btn.classList.remove('bg-red-500', 'text-white');
        btn.classList.add('bg-gray-200');
    } else {
        recognition.start();
        isRecording = true;
        btn.classList.remove('bg-gray-200');
        btn.classList.add('bg-red-500', 'text-white');
    }
}

function appendToTranscript(role, text) {
    const area = document.getElementById('transcriptArea');
    const wrapper = document.createElement('div');
    wrapper.className = role === 'ai' ? "flex gap-3 mb-4" : "flex gap-3 flex-row-reverse mb-4";
    
    wrapper.innerHTML = `
        <div class="w-8 h-8 rounded-full ${role==='ai'?'bg-blue-600':'bg-green-600'} flex items-center justify-center text-white font-bold flex-shrink-0">${role==='ai'?'AI':'You'}</div>
        <div class="${role==='ai'?'bg-blue-100 rounded-tl-none':'bg-green-100 rounded-tr-none'} p-3 rounded-lg max-w-[85%] text-gray-800">
            ${text}
        </div>
    `;
    area.appendChild(wrapper);
    area.scrollTop = area.scrollHeight;
}

async function submitAnswer(forced = false) {
    const input = document.getElementById('answerInput');
    let answer = input.value.trim();
    
    if (forced && !answer) answer = "[Time expired, no answer provided]";
    if (!answer && !isInitial) return;
    
    if (!isInitial) appendToTranscript('user', answer);
    input.value = '';
    
    if (turnTimer) clearInterval(turnTimer);
    
    const duration = Math.floor((Date.now() - startTime) / 1000);
    document.getElementById('typingIndicator').classList.remove('hidden');
    document.getElementById('submitBtn').disabled = true;

    if (isInitial && document.getElementById('welcomeMsg')) {
        document.getElementById('welcomeMsg').remove();
    }

    try {
        const res = await fetch(`/interview/session/${sessionId}/turn`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ answer, durationSeconds: duration })
        });
        const data = await res.json();
        
        if (data.action === 'finish') {
            window.location.href = `/interview/session/${sessionId}/report`;
            return;
        }
        
        if (data.question) {
            appendToTranscript('ai', data.question);
        }
        
        // Update Turn Counter in UI
        if (data.turns !== undefined) {
            document.getElementById('turnCounter').innerText = `Turn: ${data.turns}/10`;
        }
        
        // Reset timer
        startTime = Date.now();
        isInitial = false;
        startTimer();
        
    } catch (err) {
        alert('Failed to submit answer.');
    } finally {
        document.getElementById('typingIndicator').classList.add('hidden');
        document.getElementById('submitBtn').disabled = false;
    }
}

async function requestHint() {
    try {
        const res = await fetch(`/interview/session/${sessionId}/hint`, { method: 'POST' });
        const data = await res.json();
        if (data.hint) appendToTranscript('ai', `💡 Hint: ${data.hint}`);
        if (data.error) alert(data.error);
    } catch (err) {}
}

async function requestReframe() {
    try {
        const res = await fetch(`/interview/session/${sessionId}/reframe`, { method: 'POST' });
        const data = await res.json();
        if (data.reframed_question) appendToTranscript('ai', `🔄 Reframed: ${data.reframed_question}`);
        if (data.error) alert(data.error);
    } catch (err) {}
}

async function completeInterview() {
    if(confirm('Are you sure you want to end the interview now?')) {
        document.getElementById('submitBtn').innerText = 'Ending...';
        document.getElementById('submitBtn').disabled = true;
        await fetch(`/interview/session/${sessionId}/complete`, { method: 'POST' });
        window.location.href = `/interview/session/${sessionId}/report`;
    }
}

// Auto-start if empty
if (isInitial) {
    submitAnswer();
} else {
    const area = document.getElementById('transcriptArea');
    area.scrollTop = area.scrollHeight;
    startTimer();
}
</script>




