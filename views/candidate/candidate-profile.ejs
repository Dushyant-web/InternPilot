<% layout('layouts/boilerplate') %>

    <% const activeUser=(typeof candidate !=='undefined' && candidate) ? candidate : ((typeof user !=='undefined' &&
        user) ? user : currentUser); %>

        <div class="max-w-7xl mx-auto space-y-6">

            <div
                class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                    <div
                        class="w-20 h-20 bg-indigo-100 text-indigo-700 font-extrabold text-3xl rounded-full flex items-center justify-center border-2 border-indigo-200">
                        <%= (activeUser && activeUser.name) ? activeUser.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">
                            <%= activeUser ? activeUser.name : '' %>
                        </h1>
                        <p class="text-xs text-slate-500 font-medium flex items-center gap-1 mt-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-500" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <%= (activeUser && activeUser.location) ? (typeof activeUser.location==='object' ?
                                ([activeUser.location.district, activeUser.location.state].filter(Boolean).join(', ') || 'Location Not Provided') : activeUser.location)
                                : 'Location Not Provided' %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button id="openModalBtn" type="button"
                        class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-4 py-2.5 rounded-lg border border-slate-200 transition-colors cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        Edit Profile
                    </button>
                    <a href="/internships"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2.5 rounded-lg transition-colors shadow-sm">
                        Browse Internships
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">


                <div class="lg:col-span-2 space-y-6">


                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Candidate Details
                        </h2>

                        <div class="grid grid-cols-2 gap-4 text-xs">
                            <div>
                                <span class="text-slate-400 font-medium block">Age</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.age) ? activeUser.age : 'N/A' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Family Income</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.familyIncome) ? '₹' +
                                        Number(activeUser.familyIncome).toLocaleString('en-IN') + ' / year'
                                        : '₹N/A / year' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Qualification</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.education && activeUser.education.qualification) ?
                                        activeUser.education.qualification : ((activeUser && activeUser.qualification) ?
                                        activeUser.qualification : 'N/A' ) %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Institution</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.institution) ? activeUser.institution : 'N/A' %>
                                </span>
                            </div>
                        </div>

                        <div
                            class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-800 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600 shrink-0" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            Review PMIS Criteria (Age: 21–24, Family Income &lt; ₹8 Lakhs/year)
                        </div>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            Technical & Soft Skills
                        </h2>

                        <% const skillsList=activeUser ? activeUser.skills : []; %>
                            <% if (skillsList && skillsList.length> 0) { %>
                                <div class="flex flex-wrap gap-2">
                                    <% skillsList.forEach(skill=> { %>
                                        <span
                                            class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm">
                                            <%= skill %>
                                        </span>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 italic">No skills added yet.</p>
                                    <% } %>
                    </div>

                </div>

                <div class="space-y-6">
                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            AI Resume Parser
                        </h2>

                        <form action="/candidate/parse-resume" method="POST" enctype="multipart/form-data"
                            class="space-y-4">
                            <div
                                class="border-2 border-dashed border-indigo-200 rounded-xl p-6 text-center bg-indigo-50/50 hover:bg-indigo-50 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-500 mx-auto mb-2"
                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <label for="resumeInput"
                                    class="text-xs font-semibold text-indigo-700 cursor-pointer block hover:underline">
                                    Upload Resume (PDF)
                                </label>
                                <input id="resumeInput" type="file" name="resume" accept=".pdf" class="hidden"
                                    onchange="document.getElementById('fileName').innerText = this.files[0] ? this.files[0].name : ''">
                                <p id="fileName" class="text-xs text-slate-600 font-medium mt-2 truncate"></p>
                            </div>

                            <% if (activeUser && activeUser.resume) { %>
                                <div class="bg-indigo-50/50 border border-indigo-100 rounded-lg p-2.5 text-center">
                                    <a href="<%= activeUser.resume %>" target="_blank" rel="noopener noreferrer"
                                        class="text-xs text-indigo-700 hover:underline font-semibold flex items-center justify-center gap-1.5">
                                        View Currently Uploaded Resume
                                    </a>
                                </div>
                                <% } %>

                                    <button type="submit"
                                        class="w-full bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs py-2.5 rounded-lg transition-colors shadow-sm">
                                        Extract Details
                                    </button>
                        </form>
                    </div>
                </div>

            </div>

        </div>


        <div id="editProfileModal"
            class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="text-base font-bold text-slate-900">Update Profile Details</h3>
                    <button id="closeModalBtn" type="button"
                        class="text-slate-400 hover:text-slate-600 p-1 text-lg font-bold">
                        ✕
                    </button>
                </div>

                <form action="/candidate/profile/edit" method="POST" class="mt-4 space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Location (District, State)</label>
                        <input type="text" name="location"
                            value="<%= (activeUser && activeUser.location) ? (typeof activeUser.location === 'object' ? [activeUser.location.district, activeUser.location.state].filter(Boolean).join(', ') : activeUser.location) : '' %>"
                            placeholder="e.g. Noida, Uttar Pradesh"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Age</label>
                            <input type="number" name="age"
                                value="<%= (activeUser && activeUser.age) ? activeUser.age : '' %>" placeholder="21-24"
                                min="15" max="60"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Family Income (₹/year)</label>
                            <input type="number" name="familyIncome"
                                value="<%= (activeUser && activeUser.familyIncome) ? activeUser.familyIncome : '' %>"
                                placeholder="e.g. 350000"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Highest Qualification</label>
                        <input type="text" name="qualification"
                            value="<%= (activeUser && activeUser.education && activeUser.education.qualification) ? activeUser.education.qualification : ((activeUser && activeUser.qualification) ? activeUser.qualification : '') %>"
                            placeholder="e.g. B.Tech / B.Sc"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Institution Name</label>
                        <input type="text" name="institution"
                            value="<%= (activeUser && activeUser.institution) ? activeUser.institution : '' %>"
                            placeholder="e.g. Delhi University"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Skills (Comma Separated)</label>
                        <input type="text" name="skills"
                            value="<%= (activeUser && activeUser.skills) ? activeUser.skills.join(', ') : '' %>"
                            placeholder="e.g. Java, Python, SQL"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
                        <button type="button" id="cancelModalBtn"
                            class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200 cursor-pointer">Cancel</button>
                        <button type="submit"
                            class="px-4 py-2 font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm cursor-pointer">Save
                            Profile</button>
                    </div>
                </form>
            </div>
        </div>


        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const modal = document.getElementById('editProfileModal');
                const openBtn = document.getElementById('openModalBtn');
                const closeBtn = document.getElementById('closeModalBtn');
                const cancelBtn = document.getElementById('cancelModalBtn');

                if (openBtn && modal) {
                    openBtn.addEventListener('click', () => {
                        modal.classList.remove('hidden');
                    });
                }

                const closeModal = () => {
                    if (modal) modal.classList.add('hidden');
                };

                if (closeBtn) closeBtn.addEventListener('click', closeModal);
                if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
            });
        </script>