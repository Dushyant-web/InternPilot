                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Formal Education Enrollment</label>
                            <select name="enrollmentStatus" id="editEnrollmentStatus"
