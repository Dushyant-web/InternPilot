<% layout('layouts/boilerplate') %>

    <% const activeUser=(typeof candidate !=='undefined' && candidate) ? candidate : ((typeof user !=='undefined' &&
        user) ? user : currentUser); %>

    <% const pmisStatus = (typeof eligibility !== 'undefined' && eligibility) ? eligibility : {
        status: 'incomplete',
        badge: { label: 'Incomplete — More Info Needed', bgClass: 'bg-amber-50 text-amber-800 border-amber-200', icon: 'ph-warning-circle' },
        reasons: [],
        missingFields: ['Age', 'Family Income', 'Qualification', 'Enrollment Status', 'Employment Status'],
        criteria: []
    }; %>

        <div class="max-w-7xl mx-auto space-y-6">

            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-2">
                        <i class="ph-bold ph-check-circle text-emerald-600 text-base"></i>
                        <span><%= success_msg %></span>
                    </div>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-2">
                        <i class="ph-bold ph-warning-circle text-rose-600 text-base"></i>
                        <span><%= error_msg %></span>
                    </div>
                </div>
            <% } %>

            <div
                class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                    <div
                        class="w-20 h-20 bg-indigo-100 text-indigo-700 font-extrabold text-3xl rounded-full flex items-center justify-center border-2 border-indigo-200 shrink-0">
                        <%= (activeUser && activeUser.name) ? activeUser.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2.5">
                            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">
                                <%= activeUser ? activeUser.name : '' %>
                            </h1>
                            <span id="headerEligibilityBadge"
                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border <%= pmisStatus.badge.bgClass %> shadow-xs">
                                <i class="ph-bold <%= pmisStatus.badge.icon %>"></i>
                                <%= pmisStatus.badge.label %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium flex items-center gap-1 mt-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-500" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <%= (activeUser && activeUser.location) ? (typeof activeUser.location==='object' ?
                                ([activeUser.location.district, activeUser.location.state].filter(Boolean).join(', ') || 'Location Not Provided') : activeUser.location)
                                : 'Location Not Provided' %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button id="openModalBtn" type="button"
                        class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-4 py-2.5 rounded-lg border border-slate-200 transition-colors cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        Edit Profile
                    </button>

                    <a href="/candidate/resume-builder"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-lg text-xs">
                        Resume Builder
                    </a>
                    <a href="/internships"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2.5 rounded-lg transition-colors shadow-sm">
                        Browse Internships
                    </a>
                </div>
            </div>

            <!-- Dedicated PMIS Eligibility Status Card -->
            <div id="pmisEligibilityCard"
                class="bg-white border <%= pmisStatus.status === 'eligible' ? 'border-emerald-200' : (pmisStatus.status === 'ineligible' ? 'border-rose-200' : 'border-amber-200') %> rounded-2xl p-6 shadow-sm space-y-5 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-xl <%= pmisStatus.status === 'eligible' ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : (pmisStatus.status === 'ineligible' ? 'bg-rose-50 text-rose-600 border-rose-100' : 'bg-amber-50 text-amber-600 border-amber-100') %> flex items-center justify-center text-xl shrink-0 font-bold border">
                            <i class="ph-bold <%= pmisStatus.badge.icon %>"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-base font-bold text-slate-800">PMIS Eligibility Status</h2>
                                <a href="/guidelines" target="_blank"
                                    class="text-xs text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-1"
                                    title="View official PMIS guidelines">
                                    <i class="ph-bold ph-info"></i> Guidelines
                                </a>
                            </div>
                            <p class="text-xs text-slate-500">Evaluated against the Prime Minister's Internship Scheme rules</p>
                        </div>
                    </div>
                    <div class="shrink-0">
                        <span id="cardEligibilityBadge"
                            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold border <%= pmisStatus.badge.bgClass %> shadow-xs">
                            <i class="ph-bold <%= pmisStatus.badge.icon %> text-sm"></i>
                            <span><%= pmisStatus.badge.label %></span>
                        </span>
                    </div>
                </div>

                <!-- Status Feedback Callouts -->
                <% if (pmisStatus.status === 'eligible') { %>
                    <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-4 flex items-start gap-3 text-xs text-emerald-800">
                        <i class="ph-fill ph-check-circle text-emerald-600 text-lg shrink-0 mt-0.5"></i>
                        <div class="space-y-1">
                            <p class="font-bold text-emerald-900">You meet all eligibility criteria under the Prime Minister's Internship Scheme!</p>
                            <p class="text-emerald-700">You are eligible to apply for scheme internships and receive the monthly stipend (₹5,000) and one-time incident grant (₹6,000).</p>
                        </div>
                    </div>
                <% } else if (pmisStatus.status === 'ineligible') { %>
                    <div class="bg-rose-50/80 border border-rose-200 rounded-xl p-4 space-y-2.5 text-xs text-rose-800">
                        <div class="flex items-center gap-2 font-bold text-rose-900 text-sm">
                            <i class="ph-bold ph-x-circle text-rose-600 text-base shrink-0"></i>
                            <span>Disqualifying Criteria Identified:</span>
                        </div>
                        <ul class="space-y-1.5 pl-6 list-disc text-rose-700 font-medium">
                            <% pmisStatus.reasons.forEach(reason => { %>
                                <li><%= reason %></li>
                            <% }) %>
                        </ul>
                        <% if (pmisStatus.missingFields && pmisStatus.missingFields.length > 0) { %>
                            <div class="pt-2 border-t border-rose-200/60 text-rose-600">
                                <span class="font-semibold">Additionally missing:</span> <%= pmisStatus.missingFields.join('; ') %>
                            </div>
                        <% } %>
                        <p class="text-[11px] text-rose-600 pt-1">
                            If any information on your profile was entered incorrectly, you can update it by clicking <button type="button" onclick="document.getElementById('openModalBtn').click()" class="underline font-bold hover:text-rose-800 cursor-pointer">Edit Profile</button>.
                        </p>
                    </div>
                <% } else { %>
                    <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-4 space-y-2.5 text-xs text-amber-800">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex items-center gap-2 font-bold text-amber-900 text-sm">
                                <i class="ph-bold ph-warning-circle text-amber-600 text-base shrink-0"></i>
                                <span>Profile Incomplete — More Information Needed</span>
                            </div>
                            <button type="button" onclick="document.getElementById('openModalBtn').click()"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer shadow-xs shrink-0">
                                <i class="ph-bold ph-pencil-simple"></i> Complete Profile
                            </button>
                        </div>
                        <p class="text-amber-700">Please provide the following required details on your profile to verify your PMIS scheme eligibility:</p>
                        <ul class="space-y-1.5 pl-6 list-disc text-amber-900 font-medium">
                            <% pmisStatus.missingFields.forEach(field => { %>
                                <li><%= field %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <!-- Criteria Checklist Breakdown -->
                <% if (pmisStatus.criteria && pmisStatus.criteria.length > 0) { %>
                    <div>
                        <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">Eligibility Criteria Breakdown</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                            <% pmisStatus.criteria.forEach(item => { %>
                                <div class="border rounded-xl p-3 flex flex-col justify-between text-xs space-y-2 <%= item.status === 'pass' ? 'border-emerald-100 bg-emerald-50/30' : (item.status === 'fail' ? 'border-rose-100 bg-rose-50/30' : 'border-amber-100 bg-amber-50/30') %>">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="font-bold text-slate-800"><%= item.label %></span>
                                        <% if (item.status === 'pass') { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full shrink-0">
                                                <i class="ph-bold ph-check"></i> Eligible
                                            </span>
                                        <% } else if (item.status === 'fail') { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-full shrink-0">
                                                <i class="ph-bold ph-x"></i> Disqualified
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full shrink-0">
                                                <i class="ph-bold ph-warning"></i> Missing
                                            </span>
                                        <% } %>
                                    </div>
                                    <div class="text-[11px] text-slate-600">
                                        <span class="text-slate-400 block text-[10px] uppercase font-semibold">Your Profile</span>
                                        <span class="font-semibold text-slate-700"><%= item.value %></span>
                                    </div>
                                    <p class="text-[11px] <%= item.status === 'pass' ? 'text-emerald-700' : (item.status === 'fail' ? 'text-rose-700' : 'text-amber-700') %>">
                                        <%= item.message %>
                                    </p>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">


                <div class="lg:col-span-2 space-y-6">


                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Candidate Details
                        </h2>

                        <div class="grid grid-cols-2 gap-4 text-xs">
                            <div>
                                <span class="text-slate-400 font-medium block">Age</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.age) ? activeUser.age + ' years' : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Annual Family Income</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.familyIncome !== undefined && activeUser.familyIncome !== null && activeUser.familyIncome !== '') ? '₹' +
                                        Number(activeUser.familyIncome).toLocaleString('en-IN') + ' / year'
                                        : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Qualification</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.education && activeUser.education.qualification) ?
                                        activeUser.education.qualification : ((activeUser && activeUser.qualification) ?
                                        activeUser.qualification : 'Not Specified' ) %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Institution</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.institution) ? activeUser.institution : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Formal Education Status</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <% const enroll = (activeUser && activeUser.enrollmentStatus) ? activeUser.enrollmentStatus : ''; %>
                                    <%= enroll === 'not_enrolled' ? 'Not Enrolled / Completed' : (enroll === 'part_time_or_distance' ? 'Part-time / Distance' : (enroll === 'full_time' ? 'Full-time Student' : 'Not Specified')) %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Employment Status</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <% const emp = (activeUser && activeUser.employmentStatus) ? activeUser.employmentStatus : ''; %>
                                    <%= emp === 'unemployed' ? 'Unemployed / Seeking Internship' : (emp === 'part_time_or_freelance' ? 'Part-time / Freelance' : (emp === 'full_time' ? 'Full-time Employed' : 'Not Specified')) %>
                                </span>
                            </div>
                        </div>

                        <div
                            class="rounded-xl p-3 text-xs flex items-center justify-between gap-3 <%= pmisStatus.status === 'eligible' ? 'bg-emerald-50 border border-emerald-200 text-emerald-800' : (pmisStatus.status === 'ineligible' ? 'bg-rose-50 border border-rose-200 text-rose-800' : 'bg-amber-50 border border-amber-200 text-amber-800') %>">
                            <div class="flex items-center gap-2">
                                <i class="ph-bold <%= pmisStatus.badge.icon %> text-base shrink-0"></i>
                                <span>
                                    <strong>PMIS Evaluation:</strong> <%= pmisStatus.badge.label %>
                                    <% if (pmisStatus.status !== 'eligible') { %>
                                        — <%= (pmisStatus.reasons[0] || pmisStatus.missingFields[0] || 'See criteria card for details.') %>
                                    <% } %>
                                </span>
                            </div>
                            <a href="#pmisEligibilityCard"
                                class="underline font-bold shrink-0 hover:opacity-80">
                                Details
                            </a>
                        </div>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            Technical & Soft Skills
                        </h2>

                        <% const skillsList=activeUser ? activeUser.skills : []; %>
                            <% if (skillsList && skillsList.length> 0) { %>
                                <div class="flex flex-wrap gap-2">
                                    <% skillsList.forEach(skill=> { %>
                                        <span
                                            class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm">
                                            <%= skill %>
                                        </span>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 italic">No skills added yet.</p>
                                    <% } %>
                    </div>

                    <% const certifications = (activeUser && activeUser.certifications) ? activeUser.certifications : []; %>
                        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                    <i class="ph-bold ph-certificate text-indigo-600 text-lg"></i>
                                    Certifications
                                </h2>
                                <button type="button" data-cert-add
                                    class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm cursor-pointer">
                                    <i class="ph-bold ph-plus"></i> Add
                                </button>
                            </div>

                            <% if (certifications.length> 0) { %>
                                <div class="space-y-3">
                                    <% certifications.forEach(cert=> { %>
                                        <div class="border border-slate-100 rounded-lg p-3 flex items-start justify-between gap-3">
                                            <div class="min-w-0">
                                                <h4 class="text-sm font-bold text-slate-800 truncate">
                                                    <%= cert.name %>
                                                </h4>
                                                <% if (cert.issuer) { %>
                                                    <p class="text-xs text-slate-500 mt-0.5">Issued by <%= cert.issuer %>
                                                    </p>
                                                    <% } %>
                                                        <% if (cert.issueDate) { %>
                                                            <p class="text-xs text-slate-400 mt-0.5">
                                                                <%= new Date(cert.issueDate).toLocaleDateString('en-IN', {
                                                                    month: 'short' , year: 'numeric' }) %>
                                                            </p>
                                                            <% } %>
                                                                <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                                                    <% if (cert.link) { %>
                                                                        <a href="<%= cert.link %>" target="_blank"
                                                                            rel="noopener noreferrer"
                                                                            class="text-xs text-indigo-600 hover:underline font-semibold">Credential
                                                                            Link</a>
                                                                        <% } %>
                                                                            <% if (cert.fileUrl) { %>
                                                                                <a href="<%= cert.fileUrl %>" target="_blank"
                                                                                    rel="noopener noreferrer"
                                                                                    class="text-xs text-emerald-700 hover:underline font-semibold">
                                                                                    <%= cert.fileName || 'View Certificate' %>
                                                                                </a>
                                                                                <% } %>
                                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1 shrink-0">
                                                <button type="button" class="text-slate-400 hover:text-indigo-600 p-1"
                                                    title="Edit certification" data-cert-edit
                                                    data-id="<%= cert._id %>"
                                                    data-name="<%= cert.name %>"
                                                    data-issuer="<%= cert.issuer || '' %>"
                                                    data-link="<%= cert.link || '' %>"
                                                    data-issuedate="<%= cert.issueDate ? new Date(cert.issueDate).toISOString().slice(0, 10) : '' %>">
                                                    <i class="ph-bold ph-pencil-simple"></i>
                                                </button>
                                                <form action="/candidate/profile/certifications/<%= cert._id %>?_method=DELETE"
                                                    method="POST"
                                                    onsubmit="return confirm('Remove this certification?');">
                                                    <button type="submit" class="text-slate-400 hover:text-rose-600 p-1"
                                                        title="Delete certification">
                                                        <i class="ph-bold ph-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 italic">No certifications added yet.</p>
                                    <% } %>
                        </div>

                        <% const projects = (activeUser && activeUser.projects) ? activeUser.projects : []; %>
                            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                    <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                        <i class="ph-bold ph-code text-indigo-600 text-lg"></i>
                                        Projects
                                    </h2>
                                    <button type="button" data-project-add
                                        class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm cursor-pointer">
                                        <i class="ph-bold ph-plus"></i> Add
                                    </button>
                                </div>

                                <% if (projects.length> 0) { %>
                                    <div class="space-y-3">
                                        <% projects.forEach(project=> { %>
                                            <div
                                                class="border border-slate-100 rounded-lg p-3 flex items-start justify-between gap-3">
                                                <div class="min-w-0">
                                                    <h4 class="text-sm font-bold text-slate-800 truncate">
                                                        <%= project.title %>
                                                    </h4>
                                                    <% if (project.description) { %>
                                                        <p class="text-xs text-slate-500 mt-1">
                                                            <%= project.description %>
                                                        </p>
                                                        <% } %>
                                                            <% if (project.techStack && project.techStack.length> 0) { %>
                                                                <div class="flex flex-wrap gap-1.5 mt-2">
                                                                    <% project.techStack.forEach(tech=> { %>
                                                                        <span
                                                                            class="bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-semibold px-2 py-0.5 rounded">
                                                                            <%= tech %>
                                                                        </span>
                                                                        <% }) %>
                                                                </div>
                                                                <% } %>
                                                                    <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                                                        <% if (project.link) { %>
                                                                            <a href="<%= project.link %>" target="_blank"
                                                                                rel="noopener noreferrer"
                                                                                class="text-xs text-indigo-600 hover:underline font-semibold">View
                                                                                Project</a>
                                                                            <% } %>
                                                                                <% if (project.fileUrl) { %>
                                                                                    <a href="<%= project.fileUrl %>"
                                                                                        target="_blank"
                                                                                        rel="noopener noreferrer"
                                                                                        class="text-xs text-emerald-700 hover:underline font-semibold">
                                                                                        <%= project.fileName || 'View Attachment' %>
                                                                                    </a>
                                                                                    <% } %>
                                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-1 shrink-0">
                                                    <button type="button" class="text-slate-400 hover:text-indigo-600 p-1"
                                                        title="Edit project" data-project-edit
                                                        data-id="<%= project._id %>"
                                                        data-title="<%= project.title %>"
                                                        data-description="<%= project.description || '' %>"
                                                        data-link="<%= project.link || '' %>"
                                                        data-techstack="<%= (project.techStack || []).join(', ') %>">
                                                        <i class="ph-bold ph-pencil-simple"></i>
                                                    </button>
                                                    <form action="/candidate/profile/projects/<%= project._id %>?_method=DELETE"
                                                        method="POST"
                                                        onsubmit="return confirm('Remove this project?');">
                                                        <button type="submit" class="text-slate-400 hover:text-rose-600 p-1"
                                                            title="Delete project">
                                                            <i class="ph-bold ph-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <p class="text-xs text-slate-400 italic">No projects added yet.</p>
                                        <% } %>
                            </div>

                </div>

                <div class="space-y-6">
                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            AI Resume Parser
                        </h2>

                        <form action="/candidate/parse-resume" method="POST" enctype="multipart/form-data"
                            class="space-y-4" data-loading-text="Parsing Resume...">
                            <div
                                class="border-2 border-dashed border-indigo-200 rounded-xl p-6 text-center bg-indigo-50/50 hover:bg-indigo-50 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-500 mx-auto mb-2"
                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <label for="resumeInput"
                                    class="text-xs font-semibold text-indigo-700 cursor-pointer block hover:underline">
                                    Upload Resume (PDF)
                                </label>
                                <input id="resumeInput" type="file" name="resume" accept=".pdf" class="hidden"
                                    onchange="document.getElementById('fileName').innerText = this.files[0] ? this.files[0].name : ''">
                                <p id="fileName" class="text-xs text-slate-600 font-medium mt-2 truncate"></p>
                            </div>

                            <% if (activeUser && activeUser.resume) { %>
                                <div class="bg-indigo-50/50 border border-indigo-100 rounded-lg p-2.5 text-center">
                                    <a href="<%= activeUser.resume %>" target="_blank"
                                        class="text-xs text-indigo-700 hover:underline font-semibold flex items-center justify-center gap-1.5">
                                        View Currently Uploaded Resume
                                    </a>
                                </div>
                                <% } %>

                                <% if (activeUser && activeUser.resumeQuality) { %>
                                    <div class="bg-emerald-50 border border-emerald-100 rounded-lg p-4 space-y-3">
                                        <h3 class="text-sm font-bold text-slate-800">Resume Quality Feedback</h3>

                                        <% if (activeUser.resumeQuality.quantifiableAchievements && activeUser.resumeQuality.quantifiableAchievements.feedback) { %>
                                        <div>
                                            <p class="text-xs font-semibold text-slate-700">Quantifiable Achievements</p>
                                            <p class="text-xs text-slate-600"><%= activeUser.resumeQuality.quantifiableAchievements.feedback %></p>
                                        </div>
                                        <% } %>

                                        <% if (activeUser.resumeQuality.technicalSkills && activeUser.resumeQuality.technicalSkills.feedback) { %>
                                        <div>
                                            <p class="text-xs font-semibold text-slate-700">Technical Skills</p>
                                            <p class="text-xs text-slate-600"><%= activeUser.resumeQuality.technicalSkills.feedback %></p>
                                        </div>
                                        <% } %>

                                        <% if (activeUser.resumeQuality.projects && activeUser.resumeQuality.projects.feedback) { %>
                                        <div>
                                            <p class="text-xs font-semibold text-slate-700">Projects</p>
                                            <p class="text-xs text-slate-600"><%= activeUser.resumeQuality.projects.feedback %></p>
                                        </div>
                                        <% } %>

                                        <% if (activeUser.resumeQuality.overallFeedback) { %>
                                        <div>
                                            <p class="text-xs font-semibold text-slate-700">Overall Feedback</p>
                                            <p class="text-xs text-slate-600"><%= activeUser.resumeQuality.overallFeedback %></p>
