<% layout('layouts/boilerplate') %>

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Application Tracker</h2>
            <p class="text-xs text-slate-500 mt-1">Track real-time updates and AI fit scores for your applied
                opportunities.</p>
        </div>

        <div class="flex items-center gap-3">
            <% const hasAnyInterview = applications.some(app => app.interview && app.interview.status); %>
            <% if (hasAnyInterview) { %>
                <button type="button" id="toggleInterviewsBtn"
                    class="inline-flex items-center gap-2 bg-white border border-indigo-200 text-indigo-700 hover:bg-indigo-50 font-semibold text-xs px-4 py-2.5 rounded-lg shadow-sm transition-colors">
                    <i class="ph-bold ph-calendar-check"></i>
                    My Interviews
                </button>
            <% } %>
            <a href="/internships"
                class="inline-flex items-center gap-2 bg-indigo-700 hover:bg-indigo-800 text-white font-semibold text-xs px-4 py-2.5 rounded-lg shadow-sm transition-colors">
                <i class="ph-bold ph-magnifying-glass"></i>
                Find More Internships
            </a>
        </div>
    </div>

    <% if (applications.length === 0) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
            <i class="ph-bold ph-paper-plane-tilt text-4xl text-slate-300 mb-2"></i>
            <h3 class="text-base font-bold text-slate-800">No applications submitted yet</h3>
            <p class="text-xs text-slate-500 mt-1 mb-4">Browse internships and click "Apply Now" to get started.</p>
            <a href="/internships"
                class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold rounded-lg transition-colors">
                Browse Opportunities &rarr;
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 gap-4">
            <% applications.forEach(app => { %>
                <%
                    const statusUpdatedAt = app.statusUpdatedAt || app.appliedAt;
                    const relativeStatusUpdatedAt = formatRelativeTime(statusUpdatedAt);
                    const localizedStatusUpdatedAt = formatLocalizedDateTime(statusUpdatedAt);

                    // Normalize so 'Under Review', 'under_review', 'under review' all match
                    const status = String(app.status || '').toLowerCase().replace(/[\s_]+/g, '_');
                    const isWithdrawn = status === 'withdrawn';
                    const isTerminal = ['rejected', 'hired', 'accepted'].includes(status);

                    const roleTitle = (app.internship && app.internship.title) ? app.internship.title : 'Internship Posting Closed';
                    const orgName = (app.internship && (app.internship.companyName || app.internship.company))
                        ? (app.internship.companyName || app.internship.company)
                        : 'Organization Unavailable';

                    const hasInterview = !!(app.interview && app.interview.status);
                %>
                <div class="flex flex-col application-card" data-has-interview="<%= hasInterview ? 'true' : 'false' %>">
                    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col md:flex-row md:items-center justify-between gap-4">

                        <div class="space-y-2 max-w-xl">
                            <div class="flex items-center gap-2">
                                <span class="text-[11px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-full">
                                    <%= (app.internship && app.internship.sector) ? app.internship.sector : "General" %>
                                </span>
                                <span class="text-xs text-slate-400">&bull;</span>
                                <span class="text-xs text-slate-500 font-medium">
                                    Applied on <%= new Date(app.appliedAt).toLocaleDateString('en-IN', {
                                        day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </span>
                            </div>

                            <h3 class="text-base font-bold text-slate-900 leading-snug"><%= roleTitle %></h3>
                            <p class="text-xs font-semibold text-slate-600 flex items-center gap-1">
                                <i class="ph-bold ph-buildings text-slate-400"></i>
                                <%= orgName %>
                            </p>

                            <% if (app.internship) { %>
                                <div class="flex items-center gap-4 text-xs text-slate-500 pt-1">
                                    <span class="flex items-center gap-1">
                                        <i class="ph-bold ph-map-pin text-rose-500"></i>
                                        <%= typeof app.internship.location === 'object' && app.internship.location !== null
                                            ? ((app.internship.location.district ? app.internship.location.district + ', ' : '') + (app.internship.location.state || ''))
                                            : (app.internship.location || 'N/A') %>
                                    </span>
                                    <span>&bull;</span>
                                    <span class="flex items-center gap-1 text-emerald-600 font-semibold">
                                        <i class="ph-bold ph-currency-inr"></i>
                                        ₹<%= app.internship.monthlyStipend
                                            ? Number(app.internship.monthlyStipend).toLocaleString('en-IN') : '5,000' %> / mo
                                    </span>
                                </div>
                            <% } %>
                        </div>

                        <div class="flex items-center justify-between md:justify-end gap-6 pt-3 md:pt-0 border-t md:border-0 border-slate-100">
                            <div class="text-center">
                                <span class="block text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">AI Skill Fit</span>
                                <div class="px-3 py-1 rounded-lg border text-xs font-bold <%= app.matchScore >= 75 ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : (app.matchScore >= 40 ? 'bg-amber-50 border-amber-200 text-amber-700' : 'bg-rose-50 border-rose-200 text-rose-700') %>">
                                    <%= app.matchScore %>% Match
                                </div>
                            </div>

                            <div class="text-right">
                                <span class="block text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1">Status</span>

                                <% if (status === 'submitted' || status === 'pending') { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-md">
                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                        <%= status === 'pending' ? 'Pending' : 'Submitted' %>
                                    </span>
                                <% } else if (status === 'under_review') { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-md">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                        Under Review
                                    </span>
                                <% } else if (status === 'shortlisted') { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-md">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        Shortlisted
                                    </span>
                                <% } else if (status === 'interview') { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-md">
                                        <i class="ph-bold ph-calendar"></i> Interview
                                    </span>
                                <% } else if (status === 'hired') { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-medium text-indigo-700 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-md">
                                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                                        Hired
                                    </span>
                                <% } else if (status === 'rejected') { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-medium text-rose-700 bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-md">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                        Rejected
                                    </span>
                                <% } else if (isWithdrawn) { %>
                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-600 bg-slate-100 border border-slate-300 px-2.5 py-1 rounded-md">
                                        <i class="ph-bold ph-arrow-u-up-left"></i> Withdrawn
                                    </span>
                                <% } %>

                                <% if (relativeStatusUpdatedAt) { %>
                                    <time title="<%= localizedStatusUpdatedAt %>"
                                        class="block mt-1 text-[11px] text-slate-500 whitespace-nowrap">
                                        Updated <%= relativeStatusUpdatedAt %>
                                    </time>
                                <% } %>
                            </div>

                            <!-- Withdraw button if status permits -->
                            <% if (!isWithdrawn && !isTerminal) { %>
                                <div class="text-right">
                                    <button type="button"
                                        data-app-id="<%= app._id %>"
                                        data-role="<%= roleTitle %>"
                                        data-org="<%= orgName %>"
                                        onclick="openWithdrawModal(this)"
                                        class="inline-flex items-center gap-1 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 hover:border-rose-300 px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer"
                                        title="Withdraw this application">
                                        <i class="ph-bold ph-x-circle"></i> Withdraw
                                    </button>
                                </div>
                            <% } %>
                        </div>

                    </div>

                    <% if (hasInterview) { %>
                        <div class="mt-2 mx-2 bg-indigo-50 border border-indigo-100 rounded-lg p-4 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                            <div>
                                <h4 class="text-xs font-bold text-indigo-900 mb-1 flex items-center gap-1.5">
                                    <i class="ph-bold ph-calendar-check text-indigo-600 text-sm"></i>
                                    Interview <%= app.interview.status %>
                                    <% if (app.interview.status === 'Cancelled') { %>
                                        <span class="text-[10px] text-rose-600 font-semibold">(Cancelled)</span>
                                    <% } %>
                                </h4>

                                <% if (app.interview.status !== 'Cancelled') { %>
                                    <div class="text-xs text-indigo-800 space-y-1">
                                        <p><strong>Date & Time:</strong> <%= app.interview.scheduledAt ? new Date(app.interview.scheduledAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) : 'N/A' %> (IST)</p>
                                        <p><strong>Duration:</strong> <%= app.interview.duration %> mins &bull; <strong>Mode:</strong> <%= app.interview.mode %></p>

                                        <% if (app.interview.mode === 'Online' && app.interview.meetingLink) { %>
                                            <p><strong>Meeting Link:</strong> <a href="<%= app.interview.meetingLink %>" target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline font-semibold"><%= app.interview.meetingLink %></a></p>
                                        <% } else if (app.interview.mode === 'In-Person' && app.interview.location) { %>
                                            <p><strong>Location:</strong> <%= app.interview.location %></p>
                                        <% } %>

                                        <% if (app.interview.instructions) { %>
                                            <p class="mt-2 text-indigo-700 bg-indigo-100/50 p-2 rounded"><strong>Instructions:</strong> <%= app.interview.instructions %></p>
                                        <% } %>
                                    </div>
                                <% } else if (app.interview.cancelReason) { %>
                                    <p class="text-xs text-rose-700 mt-1"><strong>Reason:</strong> <%= app.interview.cancelReason %></p>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<!-- Confirmation Modal -->
<div id="trackerWithdrawModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs" onclick="closeWithdrawModal()"></div>
    <div class="fixed inset-0 z-10 flex items-center justify-center p-4">
        <div class="relative bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shrink-0">
                    <i class="ph-bold ph-warning-circle text-xl"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">Withdraw Application?</h3>
                    <p class="text-xs text-slate-500">This will remove your application from consideration.</p>
                </div>
            </div>
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs mb-4">
                <div class="font-semibold text-slate-800" id="trackerModalRole">Internship</div>
                <div class="text-slate-500" id="trackerModalOrg">Company</div>
            </div>
            <form id="trackerWithdrawForm" method="POST" action="">
                <div class="mb-4">
                    <label for="trackerReason" class="block text-xs font-semibold text-slate-700 mb-1">Reason for Withdrawal (Optional)</label>
                    <select id="trackerReason" name="reason" class="w-full text-xs border border-slate-200 rounded-xl px-3 py-2 bg-white text-slate-700 focus:ring-2 focus:ring-rose-500">
                        <option value="">No reason given</option>
                        <option value="Accepted another offer">Accepted another offer</option>
                        <option value="Schedule conflict">Schedule conflict</option>
                        <option value="Location constraints">Location constraints</option>
                        <option value="Applied by mistake">Applied by mistake</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                    <button type="button" onclick="closeWithdrawModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl">Keep Application</button>
                    <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-xl flex items-center gap-1.5"><i class="ph-bold ph-trash"></i> Confirm Withdrawal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const trackerModal = document.getElementById('trackerWithdrawModal');
    const trackerForm = document.getElementById('trackerWithdrawForm');
    const trackerModalRole = document.getElementById('trackerModalRole');
    const trackerModalOrg = document.getElementById('trackerModalOrg');
    const trackerReason = document.getElementById('trackerReason');

    function openWithdrawModal(btn) {
        const { appId, role, org } = btn.dataset;
        trackerForm.action = `/candidate/applications/${encodeURIComponent(appId)}/withdraw`;
        trackerModalRole.textContent = role;
        trackerModalOrg.textContent = org;
        trackerReason.value = '';
        trackerModal.classList.remove('hidden');
    }

    function closeWithdrawModal() {
        trackerModal.classList.add('hidden');
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeWithdrawModal();
    });

    document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('toggleInterviewsBtn');
        const appCards = document.querySelectorAll('.application-card');

        let showOnlyInterviews = false;

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                showOnlyInterviews = !showOnlyInterviews;

                if (showOnlyInterviews) {
                    toggleBtn.classList.add('bg-indigo-50', 'border-indigo-300');
                    toggleBtn.classList.remove('bg-white', 'border-indigo-200');
                } else {
                    toggleBtn.classList.remove('bg-indigo-50', 'border-indigo-300');
                    toggleBtn.classList.add('bg-white', 'border-indigo-200');
                }

                appCards.forEach(card => {
                    const hasInterview = card.getAttribute('data-has-interview') === 'true';
                    card.style.display = (showOnlyInterviews && !hasInterview) ? 'none' : 'flex';
                });
            });
        }
    });
</script>