        document.getElementById(code-tab- + problemId).setAttribute('aria-selected', 'false');
        document.getElementById(ideo-tab- + problemId).setAttribute('aria-selected', 'false');
        
        document.getElementById(tabName + -panel- + problemId).classList.remove('hidden');
        document.getElementById(tabName + -tab- + problemId).setAttribute('aria-selected', 'true');
    }

    async function startRecording(problemId) {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
            videoStreams[problemId] = stream;
            const preview = document.getElementById(preview_ + problemId);
            preview.srcObject = stream;
            preview.classList.remove('hidden');
            
            recordedChunks[problemId] = [];
            const recorder = new MediaRecorder(stream, { mimeType: 'video/webm' });
            mediaRecorders[problemId] = recorder;
            
            recorder.ondataavailable = e => { if (e.data.size > 0) recordedChunks[problemId].push(e.data); };
            recorder.start();
            
            document.getElementById(tnStart_ + problemId).classList.add('hidden');
            document.getElementById(tnStop_ + problemId).classList.remove('hidden');
            document.getElementById(tnUpload_ + problemId).classList.add('hidden');
            document.getElementById(ideoStatus_ + problemId).innerText = 'Recording in progress...';
            document.getElementById(ideoStatus_ + problemId).classList.add('text-red-500', 'font-medium', 'animate-pulse');
        } catch(err) {
            alert('Camera/Microphone access denied or not available.');
        }
    }

    function stopRecording(problemId) {
        if(mediaRecorders[problemId]) {
            mediaRecorders[problemId].stop();
            videoStreams[problemId].getTracks().forEach(track => track.stop());
            
            const preview = document.getElementById(preview_ + problemId);
            preview.muted = false; // allow playback sound
            
            setTimeout(() => {
                const blob = new Blob(recordedChunks[problemId], { type: 'video/webm' });
                preview.srcObject = null;
                preview.src = URL.createObjectURL(blob);
                preview.controls = true;
                
                document.getElementById(tnStop_ + problemId).classList.add('hidden');
                document.getElementById(tnStart_ + problemId).classList.remove('hidden');
                document.getElementById(tnStart_ + problemId).innerText = 'Retake Video';
                document.getElementById(tnUpload_ + problemId).classList.remove('hidden');
                document.getElementById(ideoStatus_ + problemId).innerText = 'Video recorded. You can review it above before submitting.';
                document.getElementById(ideoStatus_ + problemId).classList.remove('text-red-500', 'animate-pulse');
            }, 500);
        }
    }

    async function uploadVideo(problemId) {
        const btn = document.getElementById(tnUpload_ + problemId);
        btn.disabled = true;
        btn.innerText = 'Uploading...';
        document.getElementById(ideoStatus_ + problemId).innerText = 'Uploading to secure storage. This may take a minute...';
        
        // This is a UI mockup for the video upload since backend route isn't strictly required for visual sign-off
        setTimeout(() => {
            btn.innerText = 'Video Submitted!';
            btn.classList.replace('bg-green-600', 'bg-gray-500');
            document.getElementById(ideoStatus_ + problemId).innerText = 'Video successfully saved to your submission history.';
        }, 2000);
    }
</script>





